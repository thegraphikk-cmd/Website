"<!DOCTYPE html>\n<html><head>\n\n\n\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"canonical\" href=\"https://thegraphikk.com/portfolio\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Portfolio — Website Design &amp; Development Projects | The Graphikk, India\">\n<meta property=\"og:description\" content=\"Website, e-commerce and portfolio site projects designed and built by The Graphikk, a web design studio in Chennai, India.\">\n<meta property=\"og:url\" content=\"https://thegraphikk.com/portfolio\">\n<meta property=\"og:site_name\" content=\"The Graphikk\">\n<meta property=\"og:image\" content=\"https://thegraphikk.com/assets/img/og-blog.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script src=\"7767c5bc-64e3-4791-b8bc-f21f320a07a6\"><\u002Fscript>\n<script defer src=\"/_vercel/insights/script.js\"><\u002Fscript><script defer src=\"/_vercel/speed-insights/script.js\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<title>Portfolio — Website Design &amp; Development Projects | The Graphikk, India<\u002Ftitle>\n<meta name=\"description\" content=\"Website, e-commerce and portfolio site projects designed and built by The Graphikk, a web design studio in Chennai, India.\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<style>/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"dfc5c985-d70e-4ba0-a610-eb5269986cb9\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"74f73d8a-5b0b-4a63-824a-4782473a929e\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"6045bb48-8946-44ce-8467-5bf89fa9fb09\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"651bd6c2-1dfd-4dca-a01a-9e31f076a05d\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"4313ef4b-84b0-492b-a742-5cdb6398ea41\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"58631a38-88aa-432f-9e39-c47335533169\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"3c88a147-4e52-4a6c-a7aa-e39f354dab31\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* symbols2 */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"e5eaa510-2485-4a16-a4ec-e293a189f015\") format('woff2');\n  unicode-range: U+2000-2001, U+2004-2008, U+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"884a98c3-d954-436e-a724-089942c70843\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"512ded01-45fe-4020-997a-dac7f365e396\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"d069d315-7981-4021-98e9-fb33e96878ea\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"58631a38-88aa-432f-9e39-c47335533169\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"3c88a147-4e52-4a6c-a7aa-e39f354dab31\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* symbols2 */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"e5eaa510-2485-4a16-a4ec-e293a189f015\") format('woff2');\n  unicode-range: U+2000-2001, U+2004-2008, U+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"884a98c3-d954-436e-a724-089942c70843\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"512ded01-45fe-4020-997a-dac7f365e396\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"d069d315-7981-4021-98e9-fb33e96878ea\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<script src=\"ba598857-6a7f-4722-87fd-3eca842d9ef1\"><\u002Fscript>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\nbutton{font:inherit}\n::selection{background:#FFE100;color:#111}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" active=\"work\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <section data-screen-label=\"Portfolio / Hero\" style=\"max-width:1320px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(12px,2.4vw,32px) clamp(32px,4vw,48px)\">\n    <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>Portfolio<\u002Fdiv>\n    <div style=\"margin-top:20px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px\">\n      <h1 style=\"margin:0;max-width:12em;font-weight:500;font-size:clamp(40px,5.8vw,82px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Websites we've designed <span style=\"color:#9A9890\">and built<\u002Fspan><\u002Fh1>\n      <p style=\"margin:0;max-width:26em;font-size:17px;color:#555;text-wrap:pretty\">Business sites, online stores and personal portfolios. Each project shows the goal, what we built and how it performs.<\u002Fp>\n    <\u002Fdiv>\n    <div role=\"tablist\" aria-label=\"Filter projects\" style=\"margin-top:clamp(28px,4vw,40px);display:flex;flex-wrap:wrap;gap:8px\">\n      <sc-for list=\"{{ filters }}\" as=\"f\" hint-placeholder-count=\"5\">\n        <button role=\"tab\" sc-camel-on-click=\"{{ f.pick }}\" style=\"flex:none;white-space:nowrap;height:40px;padding:0 16px;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ f.bg }};color:{{ f.fg }};border:{{ f.border }}\">{{ f.label }}<\u002Fbutton>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Portfolio / Grid\" style=\"max-width:1320px;margin:0 auto;padding:0 clamp(12px,2.4vw,32px) clamp(64px,8vw,112px)\">\n    <sc-if value=\"{{ hasProjects }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,360px),1fr));gap:16px\">\n        <sc-for list=\"{{ shown }}\" as=\"p\" hint-placeholder-count=\"3\">\n          <a href=\"{{ p.href }}\" target=\"{{ p.target }}\" rel=\"{{ p.rel }}\" style=\"display:flex;flex-direction:column;gap:16px;padding:10px 10px 22px;border-radius:22px;background:#ECEBE6;color:#111\" style-hover=\"color:#111;background:#E4E3DD\">\n            <div style=\"aspect-ratio:1200/630;border-radius:14px;overflow:hidden;background:#D9E9F4\"><image-slot id=\"{{ p.slot }}\" src=\"{{ p.image }}\" shape=\"rect\" placeholder=\"Project screenshot · 1200×630\"><\u002Fimage-slot><\u002Fdiv>\n            <div style=\"padding:0 12px;display:flex;flex-direction:column;gap:10px\">\n              <div style=\"display:flex;flex-wrap:wrap;gap:6px\">\n                <sc-for list=\"{{ p.tags }}\" as=\"t\" hint-placeholder-count=\"2\"><span style=\"flex:none;white-space:nowrap;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:5px 10px;border-radius:999px;border:1px solid #CFCDC5\">{{ t }}<\u002Fspan><\u002Fsc-for>\n              <\u002Fdiv>\n              <h2 style=\"margin:0;font-weight:500;font-size:22px;letter-spacing:-0.03em\">{{ p.title }}<\u002Fh2>\n              <p style=\"margin:0;font-size:15px;color:#555\">{{ p.summary }}<\u002Fp>\n              <span style=\"margin-top:4px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">{{ p.linkLabel }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fa>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ isEmpty }}\" hint-placeholder-val=\"{{ true }}\">\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,360px),1fr));gap:16px\">\n        <div style=\"grid-column:1/-1;border-radius:22px;border:1.5px dashed #CFCDC5;padding:clamp(40px,6vw,80px) 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px\">\n          <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#666\">{{ emptyKicker }}<\u002Fdiv>\n          <h2 style=\"margin:0;max-width:16em;font-weight:500;font-size:clamp(26px,3vw,40px);line-height:1.15;letter-spacing:-0.045em;text-wrap:balance\">New projects are being added here<\u002Fh2>\n          <p style=\"margin:0;max-width:30em;color:#555\">Want to see work similar to your project before we start? Ask us and we'll share relevant examples on a call.<\u002Fp>\n          <div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:8px\">\n            <a href=\"/contact\" style=\"display:inline-flex;align-items:center;gap:12px;height:48px;padding:0 5px 0 22px;border-radius:999px;background:#FFE100;color:#111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:500\" style-hover=\"background:#111;color:#FFFFFF\">Get a Quote <span style=\"width:38px;height:38px;border-radius:50%;background:#111;color:#FFFFFF;display:flex;align-items:center;justify-content:center\">↗<\u002Fspan><\u002Fa>\n            <a href=\"/process\" style=\"display:inline-flex;align-items:center;height:48px;padding:0 22px;border-radius:999px;border:1px solid #111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\" style-hover=\"background:#111;color:#FFFFFF\">See our process<\u002Fa>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Portfolio / What we build\" style=\"border-radius:22px;background:#111;color:#FFFFFF;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto\">\n      <h2 style=\"margin:0 0 28px;font-weight:500;font-size:clamp(28px,3.4vw,46px);letter-spacing:-0.05em\">What we build <span style=\"color:#8A8A8A\">for Indian businesses and individuals<\u002Fspan><\u002Fh2>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px\">\n        <a href=\"/industries#ecommerce\" style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px;border-radius:18px;background:#1C1C1C;color:#FFFFFF\" style-hover=\"background:#2A2A2A;color:#FFFFFF\"><span style=\"font-size:18px;font-weight:500;letter-spacing:-0.03em\">E-commerce stores<\u002Fspan><span>↗<\u002Fspan><\u002Fa>\n        <a href=\"/portfolio-websites\" style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px;border-radius:18px;background:#1C1C1C;color:#FFFFFF\" style-hover=\"background:#2A2A2A;color:#FFFFFF\"><span style=\"font-size:18px;font-weight:500;letter-spacing:-0.03em\">Personal portfolios<\u002Fspan><span>↗<\u002Fspan><\u002Fa>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { filter: 'all' };\n  renderVals() {\n    // Add projects here as they're ready. Each one becomes a card.\n    // { title: 'Project name', summary: 'One line on goal and result', category: 'business' | 'store' | 'portfolio' | 'landing',\n    //   tags: ['Website', 'Chennai'], image: 'assets/img/your-screenshot.webp', href: '#' }\n    const projects = [\n      { title: 'Blues Renewables — Solar installation company', summary: 'Lead-generation website for a Chennai rooftop solar installer, with a cost-estimate enquiry form, service pages and local SEO across Tamil Nadu.', category: 'business', tags: ['Business website', 'Chennai'], image: 'https://bluesrenewables.com/images/on-grid-solar-panel-array-rooftop-chennai.jpg', href: 'https://bluesrenewables.com/', external: true },\n      { title: 'Trucks India — Truck research platform', summary: 'Research and comparison platform for new trucks in India, with prices, specs, brand pages and a guided truck finder.', category: 'business', tags: ['Business website', 'India'], image: 'assets/img/trucks-india.jpg', href: 'https://trucks-india.com/', external: true },\n      { title: 'Kavin Arulraj — Freelance designer portfolio', summary: 'Personal portfolio and service site for a Chennai graphic designer and video editor, with service pages, published pricing and local SEO.', category: 'portfolio', tags: ['Portfolio website', 'Chennai'], image: 'https://kavinarulraj.com/assets/og-default.jpg', href: 'https://kavinarulraj.com/', external: true }\n    ];\n    const cats = [['all', 'All'], ['business', 'Business sites'], ['store', 'Online stores'], ['portfolio', 'Portfolios'], ['landing', 'Landing pages']];\n    const f = this.state.filter;\n    const shown = projects.filter(p => f === 'all' || p.category === f).map((p, i) => ({ ...p, slot: 'portfolio-' + (p.category || 'p') + '-' + i, tags: p.tags || [], href: p.href || '#', target: p.external ? '_blank' : '_self', rel: p.external ? 'noopener' : '', linkLabel: p.external ? 'Visit live site ↗' : 'View project ↗' }));\n    const label = (cats.find(c => c[0] === f) || cats[0])[1];\n    return {\n      filters: cats.map(([k, l]) => ({ label: l, pick: () => this.setState({ filter: k }), bg: f === k ? '#111' : 'transparent', fg: f === k ? '#FFFFFF' : '#111', border: '1px solid ' + (f === k ? '#111' : '#CFCDC5') })),\n      shown, hasProjects: shown.length > 0, isEmpty: shown.length === 0,\n      emptyKicker: f === 'all' ? 'Coming soon' : label + ' · coming soon'\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"