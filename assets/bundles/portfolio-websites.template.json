tyle=\"flex:1 1 auto;white-space:nowrap;height:42px;padding:0 16px;border:none;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ p.bg }};color:{{ p.fg }}\">{{ p.label }}<\u002Fbutton>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"margin-top:28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:12px\">\n      <div style=\"border-radius:22px;background:#111;color:#FFFFFF;padding:clamp(22px,3vw,36px);display:flex;flex-direction:column;gap:16px\">\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#FFE100\">{{ persona.label }}<\u002Fdiv>\n        <h3 style=\"margin:0;font-weight:500;font-size:clamp(26px,3vw,40px);line-height:1.1;letter-spacing:-0.045em\">{{ persona.goal }}<\u002Fh3>\n        <p style=\"margin:0;color:#BDBDBD;font-size:17px\">{{ persona.problem }}<\u002Fp>\n        <div style=\"margin-top:auto;display:flex;align-items:center;gap:10px;padding-top:16px;border-top:1px solid #333;font-size:14px;color:#BDBDBD\"><span style=\"width:8px;height:8px;border-radius:50%;background:#2EB0EC\"><\u002Fspan>Main call to action: <span style=\"color:#FFFFFF\">{{ persona.cta }}<\u002Fspan><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"border-radius:22px;background:#ECEBE6;padding:clamp(22px,3vw,36px)\">\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;margin-bottom:16px\">Sections we'd build for you<\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,200px),1fr));gap:8px\">\n          <sc-for list=\"{{ persona.sections }}\" as=\"s\" hint-placeholder-count=\"6\">\n            <span style=\"display:flex;gap:10px;padding:14px;border-radius:14px;background:#FFFFFF;font-size:15px\"><span style=\"color:#0A8BDA\">✓<\u002Fspan>{{ s }}<\u002Fspan>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- Why your own site -->\n  <section data-screen-label=\"Portfolio / Why\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px)\">\n    <h2 style=\"margin:0 0 28px;max-width:16em;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">Why a site of your own <span style=\"color:#9A9890\">beats a profile page<\u002Fspan><\u002Fh2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px\">\n      <div style=\"border-radius:20px;background:#2EB0EC;color:#FFFFFF;padding:24px;min-height:220px;display:flex;flex-direction:column\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px\">01<\u002Fdiv><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">Found when people search your name<\u002Fh3><p style=\"margin:0;font-size:15px;color:#EAF6FE\">Name-based SEO, so clients and recruiters land on you first.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#ECEBE6;padding:24px;min-height:220px;display:flex;flex-direction:column\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">02<\u002Fdiv><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">Your work, presented your way<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">Case studies with context and results, not a feed that buries your best pieces.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#ECEBE6;padding:24px;min-height:220px;display:flex;flex-direction:column\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">03<\u002Fdiv><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">A professional address<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">yourname.com and you@yourname.com on every email and card.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#FFE100;padding:24px;min-height:220px;display:flex;flex-direction:column\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#3A3500\">04<\u002Fdiv><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">It stays yours<\u002Fh3><p style=\"margin:0;font-size:15px;color:#3A3500\">No algorithm changes, no account bans. You own the domain and the content.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- Examples -->\n  <section data-screen-label=\"Portfolio / Examples\" style=\"border-radius:22px;background:#111;color:#FFFFFF;padding:clamp(48px,6vw,88px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto\">\n      <div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px\">\n        <div>\n          <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#BDBDBD;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#FFE100\"><\u002Fspan>Portfolio styles<\u002Fdiv>\n          <h2 style=\"margin:18px 0 0;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">Three directions <span style=\"color:#8A8A8A\">we tailor to you<\u002Fspan><\u002Fh2>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"margin-top:32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px\">\n        <div style=\"display:flex;flex-direction:column;gap:14px\"><div style=\"aspect-ratio:4/5;border-radius:16px;overflow:hidden;background:#1C1C1C\"><image-slot id=\"pf-style-minimal\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Minimal · text-led, for writers and consultants\"><\u002Fimage-slot><\u002Fdiv><h3 style=\"margin:0;font-weight:500;font-size:21px;letter-spacing:-0.03em\">Minimal<\u002Fh3><p style=\"margin:0;font-size:14px;color:#BDBDBD\">Type-led and calm. Suits consultants, writers and job seekers.<\u002Fp><\u002Fdiv>\n        <div style=\"display:flex;flex-direction:column;gap:14px\"><div style=\"aspect-ratio:4/5;border-radius:16px;overflow:hidden;background:#1C1C1C\"><image-slot id=\"pf-style-visual\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Visual · full-bleed gallery, for photographers and artists\"><\u002Fimage-slot><\u002Fdiv><h3 style=\"margin:0;font-weight:500;font-size:21px;letter-spacing:-0.03em\">Visual<\u002Fh3><p style=\"margin:0;font-size:14px;color:#BDBDBD\">Big images, gallery grids, lightbox. Suits photographers, artists and designers.<\u002Fp><\u002Fdiv>\n        <div style=\"display:flex;flex-direction:column;gap:14px\"><div style=\"aspect-ratio:4/5;border-radius:16px;overflow:hidden;background:#1C1C1C\"><image-slot id=\"pf-style-brand\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Personal brand · bold, for creators and founders\"><\u002Fimage-slot><\u002Fdiv><h3 style=\"margin:0;font-weight:500;font-size:21px;letter-spacing:-0.03em\">Personal brand<\u002Fh3><p style=\"margin:0;font-size:14px;color:#BDBDBD\">Bold colour, video, media kit and stats. Suits creators, coaches and founders.<\u002Fp><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- Pricing -->\n  <section id=\"pf-pricing\" data-screen-label=\"Portfolio / Pricing\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px) 0;scroll-margin-top:96px\">\n    <div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#2EB0EC\"><\u002Fspan>Portfolio packages<\u002Fdiv>\n        <h2 style=\"margin:18px 0 0;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">Priced for individuals<\u002Fh2>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:12px\">\n      <sc-for list=\"{{ tiers }}\" as=\"t\" hint-placeholder-count=\"3\">\n        <div style=\"position:relative;border-radius:22px;padding:24px;display:flex;flex-direction:column;gap:18px;background:{{ t.bg }};color:{{ t.fg }}\">\n          <sc-if value=\"{{ t.popular }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"position:absolute;right:16px;top:16px;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:999px;background:#FFE100;color:#111\">Most chosen<\u002Fspan><\u002Fsc-if>\n          <div><h3 style=\"margin:0;font-weight:500;font-size:22px;letter-spacing:-0.03em\">{{ t.name }}<\u002Fh3><p style=\"margin:4px 0 0;font-size:14px;color:{{ t.sub }}\">{{ t.forWho }}<\u002Fp><\u002Fdiv>\n          <div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:{{ t.sub }}\">Starting at<\u002Fdiv><div style=\"margin-top:4px;font-size:46px;letter-spacing:-0.06em;line-height:1\">{{ t.price }}<\u002Fdiv><div style=\"font-size:13px;margin-top:6px;color:{{ t.sub }}\">{{ t.note }}<\u002Fdiv><\u002Fdiv>\n          <a href=\"/contact\" style=\"display:flex;align-items:center;justify-content:center;height:46px;border-radius:999px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ t.btnBg }};color:{{ t.btnFg }};border:{{ t.btnBorderCss }}\">{{ t.cta }}<\u002Fa>\n          <div style=\"display:flex;flex-direction:column;gap:10px;font-size:15px;padding-top:18px;border-top:{{ t.lineCss }}\">\n            <sc-for list=\"{{ t.features }}\" as=\"f\" hint-placeholder-count=\"5\"><span style=\"display:flex;gap:10px\"><span style=\"color:{{ t.tick }}\">✓<\u002Fspan>{{ f }}<\u002Fspan><\u002Fsc-for>\n          <\u002Fdiv>\n          <div style=\"margin-top:auto;padding-top:16px;border-top:{{ t.lineCss }};font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:{{ t.sub }}\">Delivery · {{ t.time }}<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n    <p style=\"margin:16px 0 0;font-size:14px;color:#666;text-align:center\">{{ footnote }}<\u002Fp>\n  <\u002Fsection>\n\n  <!-- Process -->\n  <section data-screen-label=\"Portfolio / Process\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px)\">\n    <h2 style=\"margin:0 0 28px;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">From folder of work <span style=\"color:#9A9890\">to live site<\u002Fspan><\u002Fh2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:0;border-top:1px solid #DDDCD6\">\n      <div style=\"padding:24px 24px 8px 0;border-right:1px solid #DDDCD6\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">01 · Day 1<\u002Fdiv><h3 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em\">Story call<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">30 minutes on who you are, who you want to reach and what they should do.<\u002Fp><\u002Fdiv>\n      <div style=\"padding:24px 24px 8px;border-right:1px solid #DDDCD6\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">02 · Days 2–4<\u002Fdiv><h3 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em\">Pick your best work<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">Send us everything. We help choose 6–12 pieces and shape each into a short case study.<\u002Fp><\u002Fdiv>\n      <div style=\"padding:24px 24px 8px;border-right:1px solid #DDDCD6\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">03 · Week 1–2<\u002Fdiv><h3 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em\">Design and build<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">A design in your style, then the build on a private link you can share for feedback.<\u002Fp><\u002Fdiv>\n      <div style=\"padding:24px 0 8px 24px\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">04 · Launch<\u002Fdiv><h3 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em\">Go live on your name<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">Domain, email, Google indexing and a video on how to add new work.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- FAQ -->\n  <section data-screen-label=\"Portfolio / FAQ\" style=\"max-width:1320px;margin:0 auto;padding:0 clamp(12px,2.4vw,32px) clamp(64px,8vw,112px)\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(28px,5vw,72px)\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>FAQ<\u002Fdiv>\n        <h2 style=\"margin:18px 0 0;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">Portfolio questions<\u002Fh2>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:8px\">\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Do I need a portfolio website if I have LinkedIn or Instagram?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Social profiles are rented space. A portfolio site on your own domain shows up when people search your name, presents your work the way you choose, and stays yours if a platform changes.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Can I update the portfolio myself?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Yes. You get an easy editor for adding projects, posts and photos, plus a short video walkthrough.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">How long does a portfolio website take?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">One-page portfolios take about a week. Multi-page portfolios with case studies take two to four weeks.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">I don't have much work yet. Can I still have one?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Yes. Students and career changers often start with two or three projects, a strong About section and a downloadable CV. You can add more later.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Can you write my bio and project descriptions?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Yes. Copywriting is included in Signature and available as an add-on for the other packages.<\u002Fp><\u002Fdetails>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Portfolio / CTA\" style=\"border-radius:22px;background:#FFE100;padding:clamp(40px,5vw,72px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px\">\n      <h2 style=\"margin:0;max-width:13em;font-weight:500;font-size:clamp(32px,4.4vw,60px);line-height:1.04;letter-spacing:-0.055em\">Put your name on the internet. <span style=\"color:#6B6200\">Properly.<\u002Fspan><\u002Fh2>\n      <div style=\"display:flex;flex-wrap:wrap;gap:10px\">\n        <a href=\"/contact\" style=\"display:inline-flex;align-items:center;gap:12px;height:50px;padding:0 5px 0 22px;border-radius:999px;background:#111;color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\" style-hover=\"color:#FFFFFF\">Start my portfolio <span style=\"width:40px;height:40px;border-radius:50%;background:#FFE100;color:#111;display:flex;align-items:center;justify-content:center\">↗<\u002Fspan><\u002Fa>\n        <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { cur: null, who: 'freelancer' };\n  renderVals() {\n    const cur = 'INR';\n    const inr = cur === 'INR', $ = (i, u) => (inr ? i : u);\n    const P = {\n      freelancer: { label: 'Freelancers', goal: 'Win better clients without cold pitching', problem: 'Marketplace profiles look the same as everyone else\\u2019s. Clients want to see how you think, not just a list of skills.', cta: 'Book a discovery call', sections: ['Case studies with results', 'Services and starting rates', 'Client testimonials', 'Calendly booking', 'About and process', 'Contact form'] },\n      job: { label: 'Job seekers', goal: 'Stand out to recruiters and hiring managers', problem: 'A CV gets six seconds. A portfolio link shows real projects and gives you something to talk about in interviews.', cta: 'Download CV', sections: ['Selected projects', 'Downloadable CV', 'Skills and tools', 'Experience timeline', 'LinkedIn and GitHub links', 'Recruiter contact'] },\n      creative: { label: 'Artists & photographers', goal: 'Let the work speak, full screen', problem: 'Instagram crops and compresses your images. Galleries on your own site show them at their best.', cta: 'Enquire about a commission', sections: ['Full-bleed galleries', 'Series and collections', 'Lightbox viewer', 'Print or booking enquiries', 'Exhibitions and press', 'Image protection'] },\n      creator: { label: 'Creators', goal: 'Turn followers into brand deals', problem: 'Brands want audience stats, past campaigns and rates in one place before they reach out.', cta: 'Request media kit', sections: ['Media kit with live stats', 'Past brand campaigns', 'Link hub for all platforms', 'Collaboration form', 'Newsletter signup', 'Shop or merch link'] },\n      founder: { label: 'Founders & coaches', goal: 'Build trust before the first call', problem: 'People buy from people. A personal site with your story, talks and writing does the warming up for you.', cta: 'Book a session', sections: ['Story and credentials', 'Speaking and podcasts', 'Articles and newsletter', 'Programmes or offers', 'Press mentions', 'Booking and payments'] }\n    };\n    const persona = P[this.state.who];\n    const style = (pop) => pop\n      ? { bg: '#111', fg: '#FFFFFF', sub: '#BDBDBD', line: '#333', tick: '#FFE100', btnBg: '#FFE100', btnFg: '#111', btnBorder: '#FFE100', btnBorderCss: '1px solid #FFE100', lineCss: '1px solid #333' }\n      : { bg: '#ECEBE6', fg: '#111', sub: '#666', line: '#DDDCD6', tick: '#0A8BDA', btnBg: 'transparent', btnFg: '#111', btnBorder: '#111', btnBorderCss: '1px solid #111', lineCss: '1px solid #DDDCD6' };\n    const tiers = [\n      { name: 'Essential', forWho: 'One page that says it all', price: $('₹20,000', '$350'), features: ['Single scrolling page', 'Up to 6 work samples', 'Bio, contact and social links', 'Name-based SEO setup', 'Mobile-first, fast'], time: '1 week' },\n      { name: 'Professional', forWho: 'For freelancers and job seekers', price: $('₹45,000', '$750'), popular: true, features: ['Up to 6 pages', 'Up to 12 projects with case-study pages', 'Blog or writing section', 'Booking or CV download', 'Easy editor for new work', '1 month of support'], time: '2–3 weeks' },\n      { name: 'Signature', forWho: 'For creators, coaches and founders', price: $('₹85,000', '$1,400'), features: ['Custom design from scratch', 'Media kit or speaker page', 'Newsletter and payments', 'Bio and project copywriting', 'Video and gallery layouts', '3 months of support'], time: '3–4 weeks' }\n    ].map(t => ({ ...t, cta: 'Choose ' + t.name, popular: !!t.popular, note: inr ? 'one-time · + GST' : 'one-time · USD', ...style(t.popular) }));\n    return {\n      fromLabel: 'From ' + $('₹20,000', '$350'),\n      personas: Object.entries(P).map(([k, v]) => ({ label: v.label, pick: () => this.setState({ who: k }), bg: this.state.who === k ? '#111' : 'transparent', fg: this.state.who === k ? '#FFFFFF' : '#111' })),\n      persona, tiers,\n      curs: [['INR', '₹ INR'], ['USD', '$ USD']].map(([k, l]) => ({ label: l, pick: () => this.setState({ cur: k }), bg: cur === k ? '#111' : 'transparent', fg: cur === k ? '#FFFFFF' : '#111' })),\n      footnote: (inr ? 'Prices exclude 18% GST.' : 'Prices in USD, no Indian tax for overseas clients.') + ' Domain and hosting billed to you directly, from about ' + $('₹3,000', '$40') + ' a year.'\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"