\"}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do I need a portfolio website if I have LinkedIn or Instagram?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Social profiles are rented space. A portfolio site on your own domain shows up when people search your name, presents your work the way you choose, and stays yours if a platform changes.\"}},{\"@type\":\"Question\",\"name\":\"Can I update the portfolio myself?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. You get an easy editor for adding projects, posts and photos, plus a short video walkthrough.\"}},{\"@type\":\"Question\",\"name\":\"How long does a portfolio website take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One-page portfolios take about a week. Multi-page portfolios with case studies take two to four weeks.\"}}]}]}<\u002Fscript>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\nbutton{font:inherit}\nsummary{list-style:none;cursor:pointer}\nsummary::-webkit-details-marker{display:none}\n::selection{background:#FFE100;color:#111}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" active=\"services\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <!-- Hero -->\n  <section data-screen-label=\"Portfolio / Hero\" style=\"position:relative;overflow:hidden;border-radius:22px;background:radial-gradient(50% 30% at 15% 100%,rgba(255,255,255,.8),transparent 70%),radial-gradient(40% 30% at 90% 100%,rgba(255,255,255,.7),transparent 70%),linear-gradient(180deg,#0A6CC2 0%,#1A8BDD 40%,#4FB0EC 72%,#B5DEF7 100%);color:#FFFFFF;padding:clamp(40px,6vw,80px) clamp(16px,3vw,40px)\">\n    <div style=\"max-widt