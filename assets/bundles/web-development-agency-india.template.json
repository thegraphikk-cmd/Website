le: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"bcee8bf8-0a50-45b9-beb0-4abd3a707ba7\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"37685f71-235f-49cc-8a6d-499aa103e84b\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<script src=\"9f4ac9ce-deff-43f2-938a-89c37dba2266\"><\u002Fscript>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"ProfessionalService\",\"name\":\"The Graphikk\",\"description\":\"Web development agency in India\",\"url\":\"https://thegraphikk.com/\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Chennai\",\"addressCountry\":\"IN\"},\"areaServed\":\"IN\",\"priceRange\":\"₹20,000 - ₹50,000+\"},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much does it cost to hire a web development agency in India?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A website is ₹40,000 for up to 50 pages with basic SEO and Google Business Profile included, extra pages are ₹5,000 each, online stores start at ₹50,000, landing pages at ₹20,000, SEO is ₹35,000 a month and ads management ₹30,000 a month, plus GST. Every project gets a fixed written quote.\"}},{\"@type\":\"Question\",\"name\":\"Do you work with businesses outside Chennai?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We work with businesses across India over Google Meet, phone and email, with GST invoices, weekly updates and a staging link that updates as we build.\"}},{\"@type\":\"Question\",\"name\":\"Who owns the code and the website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You do. Once the project is paid in full, the code, design files and content are yours.\"}},{\"@type\":\"Question\",\"name\":\"How long does a website take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Most sites launch in three to eight weeks, depending on size and integrations.\"}}]}]}<\u002Fscript>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\nbutton{font:inherit}\nsummary{list-style:none;cursor:pointer}\nsummary::-webkit-details-marker{display:none}\n::selection{background:#FFE100;color:#111}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" active=\"services\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <!-- Hero -->\n  <section data-screen-label=\"WDA / Hero\" style=\"position:relative;overflow:hidden;border-radius:22px;background:radial-gradient(55% 32% at 12% 100%,rgba(255,255,255,.85),transparent 70%),radial-gradient(45% 30% at 90% 100%,rgba(255,255,255,.8),transparent 70%),linear-gradient(180deg,#0A6CC2 0%,#1A8BDD 40%,#4FB0EC 72%,#B5DEF7 100%);color:#FFFFFF;padding:clamp(40px,6vw,80px) clamp(16px,3vw,40px) 0\">\n    <div style=\"max-width:1040px;margin:0 auto;text-align:center\">\n      <nav aria-label=\"Breadcrumb\" style=\"display:flex;justify-content:center;flex-wrap:wrap;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#EAF6FE\"><a href=\"/\" style=\"color:#EAF6FE\">Home<\u002Fa><span>/<\u002Fspan><a href=\"/locations#india\" style=\"color:#EAF6FE\">India<\u002Fa><span>/<\u002Fspan><span style=\"color:#FFE100\">Web development agency<\u002Fspan><\u002Fnav>\n      <h1 style=\"margin:22px 0 0;font-weight:500;font-size:clamp(40px,5.8vw,82px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Web development agency in India <span style=\"color:#D4ECFB\">for businesses across India<\u002Fspan><\u002Fh1>\n      <p style=\"margin:22px auto 0;max-width:36em;font-size:clamp(15px,1.3vw,18px);color:#EAF6FE;text-wrap:pretty\">The Graphikk designs and builds custom, fast, SEO-ready websites and online stores from Chennai, for businesses in every Indian city. Fixed prices in rupees, one team, GST invoices.<\u002Fp>\n      <div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:30px\">\n        <a href=\"#wda-pricing\" style=\"display:inline-flex;align-items:center;height:46px;padding:0 24px;border-radius:999px;background:rgba(0,45,95,.42);color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\" style-hover=\"background:rgba(0,45,95,.62);color:#FFFFFF\">See pricing<\u002Fa>\n        <a href=\"/contact\" style=\"display:inline-flex;align-items:center;gap:14px;height:46px;padding:0 5px 0 22px;border-radius:999px;background:#FFE100;color:#111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:500\" style-hover=\"background:#FFFFFF;color:#111\">Get a Quote <span style=\"width:36px;height:36px;border-radius:50%;background:#111;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:15px\">↗<\u002Fspan><\u002Fa>\n      <\u002Fdiv>\n      <div style=\"margin:28px auto 0;display:flex;flex-wrap:wrap;justify-content:center;gap:8px\">\n        <span style=\"display:inline-flex;flex:none;white-space:nowrap;align-items:center;height:34px;padding:0 14px;border-radius:999px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);font-size:14px\">Fixed-price quotes<\u002Fspan>\n        <span style=\"display:inline-flex;flex:none;white-space:nowrap;align-items:center;height:34px;padding:0 14px;border-radius:999px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);font-size:14px\">90+ mobile speed score<\u002Fspan>\n        <span style=\"display:inline-flex;flex:none;white-space:nowrap;align-items:center;height:34px;padding:0 14px;border-radius:999px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);font-size:14px\">You own the code<\u002Fspan>\n        <span style=\"display:inline-flex;flex:none;white-space:nowrap;align-items:center;height:34px;padding:0 14px;border-radius:999px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);font-size:14px\">Reply within 24h<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"max-width:1080px;margin:clamp(40px,5vw,56px) auto 0\">\n      <div style=\"aspect-ratio:16/8;border-radius:16px 16px 0 0;overflow:hidden;background:#FFFFFF;border:6px solid rgba(255,255,255,.75);border-bottom:none;box-shadow:0 -10px 60px -20px rgba(0,40,90,.45)\">\n        <image-slot id=\"wda-hero\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Laptop + phone mockup of a recent build · 2:1\"><\u002Fimage-slot>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- Who we work with: markets -->\n  <section data-screen-label=\"WDA / Markets\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px) 0\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(28px,5vw,72px);align-items:end\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>Where we work<\u002Fdiv>\n        <h2 style=\"margin:18px 0 0;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em;text-wrap:balance\">Based in Chennai, <span style=\"color:#9A9890\">working across India<\u002Fspan><\u002Fh2>\n      <\u002Fdiv>\n      <p style=\"margin:0;font-size:18px;color:#444;max-width:32em\">Meet us in person in Chennai, or work with us remotely from anywhere in India. Same IST hours, rupee pricing and GST invoices.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"margin-top:28px;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,190px),1fr));gap:10px\">\n      <div style=\"border-radius:18px;background:#111;color:#FFFFFF;padding:20px\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:#FFE100\">MAA<\u002Fdiv><div style=\"margin-top:22px;font-size:20px;letter-spacing:-0.03em\">Chennai<\u002Fdiv><div style=\"margin-top:4px;font-size:13px;color:#BDBDBD\">In person · Tamil or English<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#ECEBE6;padding:20px\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:#0A6FC4\">BLR<\u002Fdiv><div style=\"margin-top:22px;font-size:20px;letter-spacing:-0.03em\">Bengaluru<\u002Fdiv><div style=\"margin-top:4px;font-size:13px;color:#666\">Remote · IST<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#ECEBE6;padding:20px\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:#0A6FC4\">BOM<\u002Fdiv><div style=\"margin-top:22px;font-size:20px;letter-spacing:-0.03em\">Mumbai<\u002Fdiv><div style=\"margin-top:4px;font-size:13px;color:#666\">Remote · IST<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#ECEBE6;padding:20px\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:#0A6FC4\">DEL<\u002Fdiv><div style=\"margin-top:22px;font-size:20px;letter-spacing:-0.03em\">Delhi NCR<\u002Fdiv><div style=\"margin-top:4px;font-size:13px;color:#666\">Remote · IST<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#ECEBE6;padding:20px\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:#0A6FC4\">HYD<\u002Fdiv><div style=\"margin-top:22px;font-size:20px;letter-spacing:-0.03em\">Hyderabad<\u002Fdiv><div style=\"margin-top:4px;font-size:13px;color:#666\">Remote · IST<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#ECEBE6;padding:20px\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:#0A6FC4\">CJB<\u002Fdiv><div style=\"margin-top:22px;font-size:20px;letter-spacing:-0.03em\">Coimbatore<\u002Fdiv><div style=\"margin-top:4px;font-size:13px;color:#666\">Remote or in person<\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- Why an Indian agency -->\n  <section data-screen-label=\"WDA / Why\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px)\">\n    <div style=\"text-align:center;margin-bottom:clamp(32px,4vw,48px)\">\n      <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;justify-content:center;gap:8px\"><span style=\"width:5px;height:5px;background:#E5007D\"><\u002Fspan>Why hire us<\u002Fdiv>\n      <h2 style=\"margin:18px auto 0;max-width:16em;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em;text-wrap:balance\">What you get from an Indian agency <span style=\"color:#9A9890\">that works like a local one<\u002Fspan><\u002Fh2>\n    <\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:12px\">\n      <div style=\"border-radius:20px;background:#ECEBE6;padding:24px;min-height:220px;display:flex;flex-direction:column\"><span style=\"width:44px;height:44px;border-radius:50%;background:#2EB0EC;display:flex;align-items:center;justify-content:center\"><span style=\"width:16px;height:16px;border-radius:50%;background:#FFFFFF\"><\u002Fspan><\u002Fspan><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">Fixed prices, agreed upfront<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">Scope and cost in writing before work starts, paid in milestones. No hourly surprises.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#ECEBE6;padding:24px;min-height:220px;display:flex;flex-direction:column\"><span style=\"width:44px;height:44px;border-radius:50%;background:#111;display:flex;align-items:center;justify-content:center\"><span style=\"width:14px;height:14px;background:#2EB0EC\"><\u002Fspan><\u002Fspan><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">Design and code in one team<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">No freelancer hand-offs. The people who design your site write its code and support it.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#ECEBE6;padding:24px;min-height:220px;display:flex;flex-direction:column\"><span style=\"width:44px;height:44px;border-radius:50%;background:#E5007D;display:flex;align-items:center;justify-content:center\"><span style=\"width:13px;height:13px;background:#FFE100;transform:rotate(45deg)\"><\u002Fspan><\u002Fspan><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">Same working hours<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">We work Mon–Sat in IST, so feedback gets answered the same day.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#ECEBE6;padding:24px;min-height:220px;display:flex;flex-direction:column\"><span style=\"width:44px;height:44px;border-radius:50%;background:#FFE100;display:flex;align-items:center;justify-content:center\"><span style=\"width:18px;height:6px;border-radius:3px;background:#111\"><\u002Fspan><\u002Fspan><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">SEO built in, not bolted on<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">Clean headings, schema, Core Web Vitals and redirects are part of every build.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#ECEBE6;padding:24px;min-height:220px;display:flex;flex-direction:column\"><span style=\"width:44px;height:44px;border-radius:50%;background:#2EB0EC;display:flex;align-items:center;justify-content:center\"><span style=\"width:18px;height:18px;border-radius:50%;border:3px solid #FFFFFF\"><\u002Fspan><\u002Fspan><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">You own everything<\u002Fh3><p style=\"margin:0;font-size:15px;color:#555\">Code, design files, domain and hosting accounts are in your name once paid.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#111;color:#FFFFFF;padding:24px;min-height:220px;display:flex;flex-direction:column\"><span style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#BDBDBD\">Contracts<\u002Fspan><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.035em\">NDA and written agreement<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Signed before kickoff, with scope, timeline, payments and ownership spelled out.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- Services -->\n  <section data-screen-label=\"WDA / Services\" style=\"border-radius:22px;background:#111;color:#FFFFFF;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto\">\n      <div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px\">\n        <div>\n          <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#BDBDBD;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#FFE100\"><\u002Fspan>Web development services<\u002Fdiv>\n          <h2 style=\"margin:18px 0 0;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">What we build <span style=\"color:#8A8A8A\">and the stack behind it<\u002Fspan><\u002Fh2>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"margin-top:32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:12px\">\n        <a href=\"/industries#ecommerce\" style=\"border-radius:18px;background:#1C1C1C;color:#FFFFFF;padding:22px;display:flex;flex-direction:column;gap:10px\" style-hover=\"background:#262626;color:#FFFFFF\"><div style=\"display:flex;justify-content:space-between\"><h3 style=\"margin:0;font-weight:500;font-size:21px;letter-spacing:-0.03em\">E-commerce development<\u002Fh3><span>↗<\u002Fspan><\u002Fdiv><p style=\"margin:0;font-size:14px;color:#BDBDBD\">Stores with UPI, cards and COD, set up to convert on mobile.<\u002Fp><div style=\"margin-top:6px;display:flex;flex-wrap:wrap;gap:6px\"><span style=\"font-size:12px;padding:4px 10px;border-radius:999px;border:1px solid #3A3A3A\">Shopify<\u002Fspan><span style=\"font-size:12px;padding:4px 10px;border-radius:999px;border:1px solid #3A3A3A\">WooCommerce<\u002Fspan><span style=\"font-size:12px;padding:4px 10px;border-radius:999px;border:1px solid #3A3A3A\">Razorpay<\u002Fspan><\u002Fdiv><\u002Fa>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <!-- Pricing -->\n  <section id=\"wda-pricing\" data-screen-label=\"WDA / Pricing\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px) 0;scroll-margin-top:96px\">\n    <div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#2EB0EC\"><\u002Fspan>Pricing