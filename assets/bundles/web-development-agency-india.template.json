\n  renderVals() {\n    return { p1: '₹40,000', p2: '₹35,000', p3: '₹50,000', taxNote: 'Website and store prices are one-time. All prices plus 18% GST. UPI, bank transfer or card.' };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"