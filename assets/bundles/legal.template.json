+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"4032fb99-bc9c-4cbb-9b1e-e25aa567a14c\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"63e69bc6-71ee-43d5-b396-5b9ba2518b8d\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"2d4fdd36-0d3b-4ea4-b61e-c9b97422a714\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\nbutton{font:inherit}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <section data-screen-label=\"Legal\" style=\"max-width:820px;margin:0 auto;padding:clamp(40px,6vw,80px) 20px clamp(48px,6vw,80px)\">\n    <div role=\"tablist\" aria-label=\"Policy\" style=\"max-width:100%;display:inline-flex;flex-wrap:wrap;justify-content:center;gap:4px;padding:5px;border-radius:25px;background:#ECEBE6\">\n      <button role=\"tab\" sc-camel-on-click=\"{{ goPrivacy }}\" style=\"flex:1 1 auto;height:40px;padding:0 16px;border:none;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ bgPrivacy }};color:{{ fgPrivacy }}\">Privacy<\u002Fbutton>\n      <button role=\"tab\" sc-camel-on-click=\"{{ goTerms }}\" style=\"flex:1 1 auto;height:40px;padding:0 16px;border:none;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ bgTerms }};color:{{ fgTerms }}\">Terms<\u002Fbutton>\n      <button role=\"tab\" sc-camel-on-click=\"{{ goCookies }}\" style=\"flex:1 1 auto;height:40px;padding:0 16px;border:none;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ bgCookies }};color:{{ fgCookies }}\">Cookies<\u002Fbutton>\n    <\u002Fdiv>\n    <div data-screen-label=\"Legal / Policy\" style=\"margin-top:32px;font-size:17px;line-height:1.7;color:#333\">\n      <sc-if value=\"{{ isPrivacy }}\" hint-placeholder-val=\"{{ true }}\">\n        <h1 style=\"margin:0;font-weight:500;font-size:clamp(36px,4.6vw,60px);line-height:1.05;letter-spacing:-0.05em;color:#111\">Privacy policy<\u002Fh1>\n        <p style=\"margin:12px 0 0;font-size:14px;color:#777\">Last updated: October 2026<\u002Fp>\n        <h2 style=\"margin:36px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">What we collect<\u002Fh2><p style=\"margin:0\">Your name, email, city, budget and project type when you submit a form, plus anonymous usage data from analytics.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">How we use it<\u002Fh2><p style=\"margin:0\">To reply to your enquiry, prepare a proposal and, if you subscribe, send our monthly newsletter.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Sharing<\u002Fh2><p style=\"margin:0\">We don't sell your data. We use trusted providers for email, hosting and analytics.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Your rights<\u002Fh2><p style=\"margin:0\">Email <a href=\"mailto:thegraphikk@gmail.com\" style=\"border-bottom:1px solid #111;overflow-wrap:anywhere\">thegraphikk@gmail.com<\u002Fa> to see, correct or delete your data.<\u002Fp>\n      <\u002Fsc-if>\n      <sc-if value=\"{{ isTerms }}\" hint-placeholder-val=\"{{ false }}\">\n        <h1 style=\"margin:0;font-weight:500;font-size:clamp(36px,4.6vw,60px);line-height:1.05;letter-spacing:-0.05em;color:#111\">Terms of service<\u002Fh1>\n        <p style=\"margin:12px 0 0;font-size:14px;color:#777\">Last updated: October 2026<\u002Fp>\n        <h2 style=\"margin:36px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Scope<\u002Fh2><p style=\"margin:0\">Each project is defined in a written proposal. Work outside that scope is quoted separately.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Payments<\u002Fh2><p style=\"margin:0\">Invoices are due within seven days. Work pauses if a milestone payment is overdue.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Ownership<\u002Fh2><p style=\"margin:0\">On full payment, you own the final design, code and content created for your project.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Portfolio use<\u002Fh2><p style=\"margin:0\">We may show completed work in our portfolio unless you ask us not to.<\u002Fp>\n      <\u002Fsc-if>\n      <sc-if value=\"{{ isCookies }}\" hint-placeholder-val=\"{{ false }}\">\n        <h1 style=\"margin:0;font-weight:500;font-size:clamp(36px,4.6vw,60px);line-height:1.05;letter-spacing:-0.05em;color:#111\">Cookie policy<\u002Fh1>\n        <p style=\"margin:12px 0 0;font-size:14px;color:#777\">Last updated: October 2026<\u002Fp>\n        <h2 style=\"margin:36px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Essential cookies<\u002Fh2><p style=\"margin:0\">Needed for forms and security. These can't be switched off.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Analytics cookies<\u002Fh2><p style=\"margin:0\">Help us understand which pages are useful. Data is anonymised.<\u002Fp>\n        <h2 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em;color:#111\">Managing cookies<\u002Fh2><p style=\"margin:0\">You can block or delete cookies in your browser settings at any time.<\u002Fp>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { t: (typeof location !== 'undefined' && ['privacy', 'terms', 'cookies'].includes(location.hash.slice(1))) ? location.hash.slice(1) : 'privacy' };\n  componentDidMount() { this.h = () => { const k = location.hash.slice(1); if (['privacy', 'terms', 'cookies'].includes(k)) this.setState({ t: k }); }; window.addEventListener('hashchange', this.h); }\n  componentWillUnmount() { window.removeEventListener('hashchange', this.h); }\n  go(t) { this.setState({ t }); try { history.replaceState(null, '', '#' + t); } catch (e) {} }\n  renderVals() {\n    const s = this.state.t, bg = (k) => (s === k ? '#111' : 'transparent'), fg = (k) => (s === k ? '#FFFFFF' : '#111');\n    return {\n      isPrivacy: s === 'privacy', isTerms: s === 'terms', isCookies: s === 'cookies',\n      goPrivacy: () => this.go('privacy'), goTerms: () => this.go('terms'), goCookies: () => this.go('cookies'),\n      bgPrivacy: bg('privacy'), fgPrivacy: fg('privacy'), bgTerms: bg('terms'), fgTerms: fg('terms'), bgCookies: bg('cookies'), fgCookies: fg('cookies')\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"