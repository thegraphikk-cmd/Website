"<!DOCTYPE html>\n<html><head>\n\n\n\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"description\" content=\"Privacy policy, terms of service and cookie policy for The Graphikk, a web design and development studio in Chennai, India.\">\n<link rel=\"canonical\" href=\"https://thegraphikk.com/legal\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Privacy, Terms &amp; Cookies — The Graphikk\">\n<meta property=\"og:description\" content=\"Privacy policy, terms of service and cookie policy for The Graphikk, a web design and development studio in Chennai, India.\">\n<meta property=\"og:url\" content=\"https://thegraphikk.com/legal\">\n<meta property=\"og:site_name\" content=\"The Graphikk\">\n<meta property=\"og:image\" content=\"https://thegraphikk.com/assets/img/og-blog.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script src=\"ed898d2a-1d20-4f93-86db-4bc6589f7b3e\"><\u002Fscript>\n<script defer src=\"/_vercel/insights/script.js\"><\u002Fscript><script defer src=\"/_vercel/speed-insights/script.js\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<title>Privacy, Terms &amp; Cookies — The Graphikk<\u002Ftitle>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<style>/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"a5f1bed9-e2a3-4500-ab82-14d9e989ce44\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"36c6db65-cc61-418d-b332-e258cbb83376\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */