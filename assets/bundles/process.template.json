) format('woff2');\n  unicode-range: U+2000-2001, U+2004-2008, U+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"6975e419-2416-4560-9e09-bb337ec82f92\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"160bd2fc-3a46-4344-a407-94453b4b2d8c\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"1116dec7-28ee-47ad-a7e9-25edde4ffaec\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <section data-screen-label=\"Process / Hero\" style=\"text-align:center;padding:clamp(48px,7vw,96px) 20px clamp(40px,5vw,64px)\">\n    <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;justify-content:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>Process<\u002Fdiv>\n    <h1 style=\"margin:20px auto 0;max-width:13em;font-weight:500;font-size:clamp(40px,5.8vw,82px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Seven steps <span style=\"color:#9A9890\">from first call to live site<\u002Fspan><\u002Fh1>\n    <p style=\"margin:20px auto 0;max-width:32em;font-size:17px;color:#555\">A typical website takes four to eight weeks. You approve each stage before the next one starts.<\u002Fp>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Process / Timeline\" style=\"max-width:1100px;margin:0 auto;padding:0 clamp(12px,2.4vw,32px) clamp(64px,8vw,112px)\">\n    <div style=\"position:relative;display:flex;flex-direction:column;gap:12px\">\n      <div style=\"position:absolute;left:27px;top:20px;bottom:20px;border-left:2px dotted #B9B7AF\"><\u002Fdiv>\n      <div style=\"position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px\"><span style=\"width:56px;height:56px;border-radius:50%;background:#2EB0EC;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:13px\">01<\u002Fspan><div style=\"border-radius:20px;background:#ECEBE6;padding:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px 24px\"><div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">3–5 days<\u002Fdiv><h2 style=\"margin:6px 0 0;font-weight:500;font-size:24px;letter-spacing:-0.035em\">Discovery<\u002Fh2><\u002Fdiv><p style=\"margin:0;color:#444\">A call about your business, customers and goals. <b style=\"font-weight:600\">You get:<\u002Fb> scope, timeline and a fixed price.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div style=\"position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px\"><span style=\"width:56px;height:56px;border-radius:50%;background:#E5007D;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:13px\">02<\u002Fspan><div style=\"border-radius:20px;background:#ECEBE6;padding:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px 24px\"><div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">1 week<\u002Fdiv><h2 style=\"margin:6px 0 0;font-weight:500;font-size:24px;letter-spacing:-0.035em\">Strategy and wireframes<\u002Fh2><\u002Fdiv><p style=\"margin:0;color:#444\">Sitemap, keywords and page structure. <b style=\"font-weight:600\">You get:<\u002Fb> grey-box wireframes of every key page.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div style=\"position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px\"><span style=\"width:56px;height:56px;border-radius:50%;background:#FFE100;color:#111;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:13px\">03<\u002Fspan><div style=\"border-radius:20px;background:#ECEBE6;padding:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px 24px\"><div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">1–2 weeks<\u002Fdiv><h2 style=\"margin:6px 0 0;font-weight:500;font-size:24px;letter-spacing:-0.035em\">Design<\u002Fh2><\u002Fdiv><p style=\"margin:0;color:#444\">Full visual design for desktop and mobile. <b style=\"font-weight:600\">You get:<\u002Fb> a clickable prototype to review.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div style=\"position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px\"><span style=\"width:56px;height:56px;border-radius:50%;background:#111;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:13px\">04<\u002Fspan><div style=\"border-radius:20px;background:#ECEBE6;padding:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px 24px\"><div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">2–3 weeks<\u002Fdiv><h2 style=\"margin:6px 0 0;font-weight:500;font-size:24px;letter-spacing:-0.035em\">Development<\u002Fh2><\u002Fdiv><p style=\"margin:0;color:#444\">Build, content entry and integrations. <b style=\"font-weight:600\">You get:<\u002Fb> a private staging link that updates as we go.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div style=\"position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px\"><span style=\"width:56px;height:56px;border-radius:50%;background:#2EB0EC;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:13px\">05<\u002Fspan><div style=\"border-radius:20px;background:#ECEBE6;padding:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px 24px\"><div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">3–5 days<\u002Fdiv><h2 style=\"margin:6px 0 0;font-weight:500;font-size:24px;letter-spacing:-0.035em\">Testing<\u002Fh2><\u002Fdiv><p style=\"margin:0;color:#444\">Real devices, browsers, speed and accessibility. <b style=\"font-weight:600\">You get:<\u002Fb> a test report and fixes.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div style=\"position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px\"><span style=\"width:56px;height:56px;border-radius:50%;background:#E5007D;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:13px\">06<\u002Fspan><div style=\"border-radius:20px;background:#ECEBE6;padding:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px 24px\"><div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">1 day<\u002Fdiv><h2 style=\"margin:6px 0 0;font-weight:500;font-size:24px;letter-spacing:-0.035em\">Launch<\u002Fh2><\u002Fdiv><p style=\"margin:0;color:#444\">Go live with redirects, analytics and Search Console. <b style=\"font-weight:600\">You get:<\u002Fb> a launch checklist, signed off.<\u002Fp><\u002Fdiv><\u002Fdiv>\n      <div style=\"position:relative;display:grid;grid-template-columns:56px 1fr;gap:16px\"><span style=\"width:56px;height:56px;border-radius:50%;background:#FFE100;color:#111;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:13px\">07<\u002Fspan><div style=\"border-radius:20px;background:#111;color:#FFFFFF;padding:22px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px 24px\"><div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#BDBDBD\">Ongoing<\u002Fdiv><h2 style=\"margin:6px 0 0;font-weight:500;font-size:24px;letter-spacing:-0.035em\">Support<\u002Fh2><\u002Fdiv><p style=\"margin:0;color:#BDBDBD\">Included support period, then an optional care plan. <b style=\"font-weight:600;color:#FFFFFF\">You get:<\u002Fb> updates, backups and monthly speed checks.<\u002Fp><\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Process / CTA\" style=\"border-radius:22px;background:radial-gradient(50% 40% at 10% 100%,rgba(255,255,255,.7),transparent 70%),linear-gradient(160deg,#0A6CC2,#2EA0E8 60%,#8FD0F4);color:#FFFFFF;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:28px\">\n      <h2 style=\"margin:0;max-width:12em;font-weight:500;font-size:clamp(34px,4.6vw,64px);line-height:1.04;letter-spacing:-0.055em\">Step one is a short brief. <span style=\"color:#D4ECFB\">It takes two minutes.<\u002Fspan><\u002Fh2>\n      <a href=\"/contact\" style=\"display:inline-flex;align-items:center;gap:14px;height:50px;padding:0 5px 0 22px;border-radius:999px;background:#FFE100;color:#111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:500\" style-hover=\"background:#FFFFFF;color:#111\">Get a Quote <span style=\"width:40px;height:40px;border-radius:50%;background:#111;color:#FFFFFF;display:flex;align-items:center;justify-content:center\">↗<\u002Fspan><\u002Fa>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n\n\n<\u002Fbody><\u002Fhtml>"