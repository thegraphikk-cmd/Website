format('woff2');\n  unicode-range: U+2000-2001, U+2004-2008, U+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"676eff24-298e-4581-aa9d-9d97581a8492\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"f3e44625-3e26-45b5-98a9-cd14cf7d9b26\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"6f324bc6-5162-4015-8a51-d41434c79bcc\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<script src=\"82dd2ec7-aa67-4ec0-b255-623eee1ec9f2\"><\u002Fscript>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\ninput,select,button{font:inherit}\n::selection{background:#FFE100;color:#111}\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n\n  <div style=\"position:sticky;top:8px;z-index:50;padding-bottom:8px\">\n    <header style=\"max-width:1320px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;height:60px;padding:0 8px 0 18px;border-radius:999px;background:rgba(255,255,255,.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 10px 30px -18px rgba(0,0,0,.35)\">\n      <a href=\"/\" style=\"display:flex;align-items:center;gap:10px\" style-hover=\"color:#111\"><img src=\"data:image/png;base64,\" alt=\"The Graphikk pen-nib logo\" width=\"26\" height=\"24\" style=\"display:block\"><span style=\"font-weight:600;font-size:19px;letter-spacing:-0.03em;white-space:nowrap\">The Graphikk<\u002Fspan><\u002Fa>\n      <sc-if value=\"{{ isDesktop }}\" hint-placeholder-val=\"{{ true }}\">\n        <nav style=\"display:flex;gap:30px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">\n          <a href=\"/portfolio\">Portfolio<\u002Fa><a href=\"/industries\">Industries<\u002Fa><a href=\"/pricing\">Pricing<\u002Fa><a href=\"/about\">About<\u002Fa><a href=\"/blog\">Blog<\u002Fa>\n        <\u002Fnav>\n      <\u002Fsc-if>\n      <div style=\"display:flex;gap:6px;align-items:center\">\n        <sc-if value=\"{{ isDesktop }}\" hint-placeholder-val=\"{{ true }}\"><a href=\"/contact\" style=\"display:inline-flex;align-items:center;height:44px;padding:0 20px;border-radius:999px;background:#111;color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:500\" style-hover=\"color:#FFFFFF\">Get a Quote<\u002Fa><\u002Fsc-if>\n        <sc-if value=\"{{ isMobile }}\" hint-placeholder-val=\"{{ false }}\">\n          <button sc-camel-on-click=\"{{ toggleMenu }}\" aria-label=\"Menu\" style=\"width:44px;height:44px;border-radius:999px;border:none;background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer\"><span style=\"width:16px;height:1.5px;background:#FFFFFF\"><\u002Fspan><span style=\"width:16px;height:1.5px;background:#FFFFFF\"><\u002Fspan><\u002Fbutton>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n    <\u002Fheader>\n    <sc-if value=\"{{ menuVisible }}\" hint-placeholder-val=\"{{ false }}\">\n      <nav style=\"max-width:1320px;margin:8px auto 0;border-radius:18px;background:#FFFFFF;box-shadow:0 20px 40px -20px rgba(0,0,0,.3);padding:6px 20px;display:flex;flex-direction:column;font-size:20px;letter-spacing:-0.03em\">\n        <a href=\"/portfolio\" style=\"padding:12px 0;border-bottom:1px solid #EEE\">Portfolio<\u002Fa><a href=\"/industries\" style=\"padding:12px 0;border-bottom:1px solid #EEE\">Industries<\u002Fa><a href=\"/pricing\" style=\"padding:12px 0;border-bottom:1px solid #EEE\">Pricing<\u002Fa><a href=\"/about\" style=\"padding:12px 0;border-bottom:1px solid #EEE\">About<\u002Fa><a href=\"/blog\" style=\"padding:12px 0\">Blog<\u002Fa>\n      <\u002Fnav>\n    <\u002Fsc-if>\n  <\u002Fdiv>\n\n  <section data-screen-label=\"Contact / Main\" style=\"border-radius:22px;background:radial-gradient(55% 35% at 10% 100%,rgba(255,255,255,.85),transparent 70%),radial-gradient(45% 30% at 95% 100%,rgba(255,255,255,.6),transparent 70%),linear-gradient(180deg,#0A6CC2 0%,#1A8BDD 40%,#4FB0EC 75%,#B5DEF7 100%);padding:clamp(40px,6vw,88px) clamp(16px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(32px,5vw,72px);align-items:start\">\n      <div style=\"color:#FFFFFF\">\n        <span style=\"display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 14px;border-radius:999px;background:rgba(0,45,95,.42);font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase\"><span style=\"width:7px;height:7px;border-radius:50%;background:#FFE100\"><\u002Fspan>Response within 24h<\u002Fspan>\n        <h1 style=\"margin:22px 0 0;font-weight:500;font-size:clamp(42px,5.8vw,82px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Get a quote <span style=\"color:#D4ECFB\">for your website<\u002Fspan><\u002Fh1>\n        <p style=\"margin:20px 0 0;max-width:28em;font-size:17px;color:#EAF6FE;text-wrap:pretty\">Five short questions. We'll reply with a plan, a timeline and a fixed price.<\u002Fp>\n        <div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:28px\">\n          <a href=\"#book\" style=\"display:inline-flex;align-items:center;height:48px;padding:0 22px;border-radius:999px;background:rgba(0,45,95,.42);color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\" style-hover=\"background:rgba(0,45,95,.62);color:#FFFFFF\">Book a 20-min call<\u002Fa>\n        <\u002Fdiv>\n        <div style=\"margin-top:36px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;max-width:520px\">\n          <div style=\"border-radius:18px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);padding:18px\">\n            <div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#EAF6FE\">Chennai · IST<\u002Fdiv>\n            <div style=\"margin-top:6px;font-size:34px;letter-spacing:-0.05em;line-height:1\">{{ timeIST }}<\u002Fdiv>\n            <div style=\"margin-top:10px;font-size:13px;color:#EAF6FE\">Mon–Sat · 10:00–19:00<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"border-radius:18px;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);padding:18px\">\n            <div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#EAF6FE\">Reply time<\u002Fdiv>\n            <div style=\"margin-top:6px;font-size:34px;letter-spacing:-0.05em;line-height:1\">24h<\u002Fdiv>\n            <div style=\"margin-top:10px;font-size:13px;color:#EAF6FE\">Email or call<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"margin-top:14px;font-size:15px;color:#EAF6FE\">Or email <a href=\"mailto:thegraphikk@gmail.com\" style=\"color:#FFFFFF;border-bottom:1px solid rgba(255,255,255,.6);overflow-wrap:anywhere\">thegraphikk@gmail.com<\u002Fa><\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"background:#FFFFFF;border-radius:22px;padding:clamp(20px,2.8vw,32px);box-shadow:0 30px 60px -20px rgba(0,40,90,.45)\">\n        <sc-if value=\"{{ sent }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"min-height:420px;display:flex;flex-direction:column;justify-content:center;gap:12px\">\n            <span style=\"width:52px;height:52px;border-radius:50%;background:#FFE100;display:flex;align-items:center;justify-content:center;font-size:22px\">✓<\u002Fspan>\n            <h2 style=\"margin:0;font-weight:500;font-size:30px;letter-spacing:-0.045em\">{{ thanksLine }}<\u002Fh2>\n            <p style=\"margin:0;color:#555\">Your brief is in. Expect a reply within 24 hours, usually much sooner.<\u002Fp>\n            <button sc-camel-on-click=\"{{ resetForm }}\" style=\"align-self:flex-start;margin-top:6px;height:42px;padding:0 18px;border-radius:999px;border:1px solid #CFCDC5;background:#FFFFFF;cursor:pointer;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase\">Send another<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ notSent }}\" hint-placeholder-val=\"{{ true }}\">\n          <form sc-camel-on-submit=\"{{ submit }}\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:16px\">\n            <h2 style=\"grid-column:1/-1;margin:0 0 4px;font-weight:500;font-size:24px;letter-spacing:-0.04em\">Project details<\u002Fh2>\n            <label style=\"display:flex;flex-direction:column;gap:6px\"><span style=\"font-size:13px;color:#555\">Name<\u002Fspan><input name=\"name\" required=\"\" autocomplete=\"name\" style=\"height:52px;padding:0 16px;border-radius:12px;border:1px solid #DDDCD6;background:#F7F6F2;font-size:16px;outline:none\" style-focus=\"border-color:#0A8BDA;background:#FFFFFF\"><\u002Flabel>\n            <label style=\"display:flex;flex-direction:column;gap:6px\"><span style=\"font-size:13px;color:#555\">Email<\u002Fspan><input name=\"email\" type=\"email\" required=\"\" autocomplete=\"email\" style=\"height:52px;padding:0 16px;border-radius:12px;border:1px solid #DDDCD6;background:#F7F6F2;font-size:16px;outline:none\" style-focus=\"border-color:#0A8BDA;background:#FFFFFF\"><\u002Flabel>\n            <label style=\"display:flex;flex-direction:column;gap:6px\"><span style=\"font-size:13px;color:#555\">City<\u002Fspan><input name=\"city\" autocomplete=\"address-level2\" placeholder=\"e.g. Chennai\" style=\"height:52px;padding:0 12px;border-radius:12px;border:1px solid #DDDCD6;background:#F7F6F2;font-size:16px;outline:none\" style-focus=\"border-color:#0A8BDA;background:#FFFFFF\"><\u002Flabel>\n            <label style=\"display:flex;flex-direction:column;gap:6px\"><span style=\"font-size:13px;color:#555\">Project type<\u002Fspan><sc-raw-select name=\"type\" style=\"height:52px;padding:0 12px;border-radius:12px;border:1px solid #DDDCD6;background:#F7F6F2;font-size:16px;outline:none\"><option>Website design &amp; build<\u002Foption><option>E-commerce store<\u002Foption><option>Landing page<\u002Foption><option>Portfolio / personal brand<\u002Foption><option>Redesign<\u002Foption><option>Maintenance &amp; SEO<\u002Foption><\u002Fsc-raw-select><\u002Flabel>\n            <label style=\"display:flex;flex-direction:column;gap:6px;grid-column:1/-1\"><span style=\"font-size:13px;color:#555\">Budget range<\u002Fspan>\n              <sc-raw-select name=\"budget\" style=\"height:52px;padding:0 12px;border-radius:12px;border:1px solid #DDDCD6;background:#F7F6F2;font-size:16px;outline:none\"><option>Under ₹50,000<\u002Foption><option>₹50,000 – ₹1,50,000<\u002Foption><option>₹1,50,000 – ₹4,00,000<\u002Foption><option>₹4,00,000+<\u002Foption><option>Not sure yet<\u002Foption><\u002Fsc-raw-select>\n            <\u002Flabel>\n            <button type=\"submit\" style=\"grid-column:1/-1;margin-top:4px;height:56px;border:none;border-radius:999px;background:#111;color:#FFFFFF;cursor:pointer;display:flex;align-items:center;justify-content:space-between;padding:0 6px 0 24px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\" style-hover=\"background:#000\">Send my brief <span style=\"width:44px;height:44px;border-radius:50%;background:#FFE100;color:#111;display:flex;align-items:center;justify-content:center;font-size:16px\">↗<\u002Fspan><\u002Fbutton>\n            <p style=\"grid-column:1/-1;margin:0;font-size:13px;color:#666\">We only use your details to reply to this enquiry.<\u002Fp>\n          <\u002Fform>\n        <\u002Fsc-if>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Contact / Next steps\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px) 0\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(28px,5vw,72px);align-items:center\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>What happens next<\u002Fdiv>\n        <h2 style=\"margin:18px 0 28px;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">From brief <span style=\"color:#9A9890\">to kickoff in a week<\u002Fspan><\u002Fh2>\n        <div style=\"display:flex;flex-direction:column\">\n          <div style=\"display:grid;grid-template-columns:48px 1fr;gap:16px;padding:20px 0;border-top:1px solid #DDDCD6\"><span style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">01<\u002Fspan><div><h3 style=\"margin:0 0 4px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">We reply within 24 hours<\u002Fh3><p style=\"margin:0;color:#555\">With questions, or a first recommendation if the brief is clear.<\u002Fp><\u002Fdiv><\u002Fdiv>\n          <div style=\"display:grid;grid-template-columns:48px 1fr;gap:16px;padding:20px 0;border-top:1px solid #DDDCD6\"><span style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">02<\u002Fspan><div><h3 style=\"margin:0 0 4px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">A 20-minute call<\u002Fh3><p style=\"margin:0;color:#555\">On Google Meet or a phone call, at a time that suits you, in IST.<\u002Fp><\u002Fdiv><\u002Fdiv>\n          <div style=\"display:grid;grid-template-columns:48px 1fr;gap:16px;padding:20px 0;border-top:1px solid #DDDCD6;border-bottom:1px solid #DDDCD6\"><span style=\"font-family:'Geist Mono',monospace;font-size:12px;color:#888\">03<\u002Fspan><div><h3 style=\"margin:0 0 4px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">Proposal and fixed price<\u002Fh3><p style=\"margin:0;color:#555\">Scope, timeline and cost in writing. Work starts once you approve.<\u002Fp><\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"aspect-ratio:4/3;border-radius:22px;overflow:hidden;background:#ECEBE6\"><image-slot id=\"contact-illustration\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Studio photo or simple illustration\"><\u002Fimage-slot><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <footer style=\"padding:clamp(56px,7vw,88px) clamp(12px,2.4vw,32px) 24px\">\n    <div style=\"max-width:1320px;margin:0 auto\">\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(calc(50% - 14px),180px),1fr));gap:36px 28px\">\n        <div style=\"grid-column:span 2;min-width:0\">\n          <div style=\"display:flex;align-items:center;gap:10px\"><img src=\"data:image/png;base64,\" alt=\"The Graphikk pen-nib logo\" width=\"26\" height=\"24\" style=\"display:block\"><span style=\"font-weight:600;font-size:19px;letter-spacing:-0.03em\">The Graphikk<\u002Fspan><\u002Fdiv>\n          <p style=\"margin:16px 0 22px;max-width:24em;color:#555;font-size:15px\">Website design and development from Chennai, for businesses and individuals across India.<\u002Fp>\n          <form sc-camel-on-submit=\"{{ subscribe }}\" style=\"display:flex;max-width:420px;padding:5px;border-radius:999px;background:#ECEBE6\"><input type=\"email\" required=\"\" placeholder=\"Monthly newsletter · your email\" aria-label=\"Email\" style=\"flex:1;min-width:0;height:42px;padding:0 16px;background:transparent;border:none;font-size:15px;outline:none\"><button type=\"submit\" style=\"height:42px;padding:0 18px;border:none;border-radius:999px;background:#111;color:#FFFFFF;cursor:pointer;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase\">{{ subLabel }}<\u002Fbutton><\u002Fform>\n        <\u002Fdiv>\n        <div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#777;margin-bottom:14px\">Services<\u002Fdiv><div style=\"display:flex;flex-direction:column;gap:9px;font-size:15px\"><a href=\"/industries#ecommerce\">E-commerce<\u002Fa><a href=\"/portfolio-websites\">Portfolio Websites<\u002Fa><\u002Fdiv><\u002Fdiv>\n        <div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#777;margin-bottom:14px\">Locations<\u002Fdiv><div style=\"display:flex;flex-direction:column;gap:9px;font-size:15px\"><a href=\"/web-development-company-chennai\">Web Development Company Chennai<\u002Fa><a href=\"/locations#india\">Web Design India<\u002Fa><a href=\"/web-development-agency-india\">Web Development Agency India<\u002Fa><\u002Fdiv><\u002Fdiv>\n        <div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#777;margin-bottom:14px\">Contact<\u002Fdiv><div style=\"display:flex;flex-direction:column;gap:9px;font-size:15px\"><a href=\"mailto:thegraphikk@gmail.com\" style=\"overflow-wrap:anywhere\">thegraphikk@gmail.com<\u002Fa><\u002Fdiv><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"margin-top:clamp(48px,6vw,72px);font-weight:500;font-size:clamp(48px,12.5vw,190px);line-height:.85;letter-spacing:-0.07em;overflow-wrap:anywhere\">The Graphikk<\u002Fdiv>\n      <div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #DDDCD6;display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px;font-size:13px;color:#666\"><span>© 2026 The Graphikk. Chennai, India.<\u002Fspan><div style=\"display:flex;gap:18px\"><a href=\"/legal#privacy\" style=\"color:#666\">Privacy<\u002Fa><a href=\"/legal#terms\" style=\"color:#666\">Terms<\u002Fa><a href=\"/legal#cookies\" style=\"color:#666\">Cookies<\u002Fa><\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Ffooter>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { w: typeof window !== 'undefined' ? window.innerWidth : 1280, menu: false, sub: false, sent: false, sentName: '', india: true, now: Date.now() };\n  componentDidMount() {\n    this.r = () => this.setState({ w: window.innerWidth }); window.addEventListener('resize', this.r);\n    this.t = setInterval(() => this.setState({ now: Date.now() }), 30000);\n  }\n  componentWillUnmount() { window.removeEventListener('resize', this.r); clearInterval(this.t); }\n  fmt(tz) { try { return new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: tz }).format(this.state.now); } catch (e) { return '--:--'; } }\n  renderVals() {\n    const m = this.state.w < 900;\n    return {\n      isMobile: m, isDesktop: !m, menuVisible: m && this.state.menu,\n      toggleMenu: () => this.setState(s => ({ menu: !s.menu })),\n      subscribe: (e) => { e.preventDefault(); this.setState({ sub: true }); },\n      subLabel: this.state.sub ? 'Subscribed ✓' : 'Subscribe',\n      timeIST: this.fmt('Asia/Kolkata'),\n     \n      sent: this.state.sent, notSent: !this.state.sent, sentName: this.state.sentName, thanksLine: 'Thanks' + (this.state.sentName ? ', ' + this.state.sentName : '') + '.',\n      submit: (e) => { e.preventDefault(); const n = new FormData(e.target).get('name') || ''; this.setState({ sent: true, sentName: String(n).split(' ')[0] }); },\n      resetForm: () => this.setState({ sent: false, india: true })\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"