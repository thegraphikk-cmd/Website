pment from Chennai, for businesses and individuals across India.<\u002Fp>\n          <form sc-camel-on-submit=\"{{ subscribe }}\" style=\"display:flex;max-width:420px;padding:5px;border-radius:999px;background:#ECEBE6\">\n            <input type=\"email\" required=\"\" placeholder=\"Monthly newsletter · your email\" aria-label=\"Email\" style=\"flex:1;min-width:0;height:42px;padding:0 16px;background:transparent;border:none;font-size:15px;outline:none\">\n            <button type=\"submit\" style=\"height:42px;padding:0 18px;border:none;border-radius:999px;background:#111;color:#FFFFFF;cursor:pointer;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase\">{{ subLabel }}<\u002Fbutton>\n          <\u002Fform>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#777;margin-bottom:14px\">Services<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:9px;font-size:15px\"><a href=\"/industries#ecommerce\">E-commerce<\u002Fa><a href=\"/portfolio-websites\">Portfolio Websites<\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#777;margin-bottom:14px\">Locations<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:9px;font-size:15px\"><a href=\"/web-development-company-chennai\">Web Development Company Chennai<\u002Fa><a href=\"/locations#india\">Web Design India<\u002Fa><a href=\"/web-development-agency-india\">Web Development Agency India<\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#777;margin-bottom:14px\">Contact<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:9px;font-size:15px\"><a href=\"mailto:thegraphikk@gmail.com\" style=\"overflow-wrap:anywhere\">thegraphikk@gmail.com<\u002Fa><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"margin-top:clamp(48px,6vw,72px);font-weight:500;font-size:clamp(48px,12.5vw,190px);line-height:.85;letter-spacing:-0.07em;color:#111;overflow-wrap:anywhere\">The Graphikk<\u002Fdiv>\n      <div style=\"margin-top:24px;padding-top:18px;border-top:1px solid #DDDCD6;display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px;font-size:13px;color:#666\">\n        <span>© 2026 The Graphikk. Chennai, India.<\u002Fspan>\n        <div style=\"display:flex;gap:18px\"><a href=\"/legal#privacy\" style=\"color:#666\">Privacy<\u002Fa><a href=\"/legal#terms\" style=\"color:#666\">Terms<\u002Fa><a href=\"/legal#cookies\" style=\"color:#666\">Cookies<\u002Fa><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Ffooter>\n\n  <sc-if value=\"{{ isMobile }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"height:72px\"><\u002Fdiv>\n    <div style=\"position:fixed;left:12px;right:12px;bottom:12px;z-index:60;display:flex;gap:8px;padding:6px;border-radius:999px;background:rgba(17,17,17,.9);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)\">\n      <a href=\"mailto:thegraphikk@gmail.com\" style=\"flex:1;height:46px;border-radius:999px;display:flex;align-items:center;justify-content:center;color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">Email us<\u002Fa>\n      <a href=\"#quote\" style=\"flex:1.2;height:46px;border-radius:999px;display:flex;align-items:center;justify-content:center;background:#FFE100;color:#111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">Get a Quote ↗<\u002Fa>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;heroPhoto&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Hero&quot;},&quot;cardSpeed&quot;:{&quot;editor&quot;:&quot;range&quot;,&quot;default&quot;:28,&quot;min&quot;:0,&quot;max&quot;:120,&quot;step&quot;:4,&quot;unit&quot;:&quot;px/s&quot;,&quot;tsType&quot;:&quot;number&quot;,&quot;section&quot;:&quot;Hero&quot;}}\">\nclass Component extends DCLogic {\n  state = { w: typeof window !== 'undefined' ? window.innerWidth : 1280, menu: false, sent: false, sentName: '', subscribed: false };\n  componentDidMount() {\n    this.onResize = () => this.setState({ w: window.innerWidth });\n    window.addEventListener('resize', this.onResize);\n    cancelAnimationFrame(this.raf); this.raf = null;\n    this.startArc();\n  }\n  componentWillUnmount() { window.removeEventListener('resize', this.onResize); cancelAnimationFrame(this.raf); }\n  arcRef = (el) => { if (el) this.arcEl = el; };\n  startArc() {\n    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    let off = 0, last = performance.now(), t0 = last, vel = 0;\n    const tick = (now) => {\n      this.raf = requestAnimationFrame(tick);\n      const el = (this.arcEl && this.arcEl.isConnected) ? this.arcEl : document.querySelector('[data-arc]');\n      if (!el) { last = now; return; }\n      this.arcEl = el;\n      const cards = Array.from(el.children);\n      if (!cards.length) { last = now; return; }\n      const dt = Math.min(0.05, (now - last) / 1000); last = now;\n      const target = reduce ? 0 : (this.hoverArc ? 0 : (this.props.cardSpeed ?? 28));\n      vel += (target - vel) * Math.min(1, dt * 3);\n      off += vel * dt;\n      const gap = 16, ws = cards.map(c => c.offsetWidth);\n      const total = ws.reduce((a, w) => a + w + gap, 0);\n      const W = Math.min(Math.max(300, el.clientWidth / 2), total / 2 / 1.12);\n      let acc = -total / 2;\n      cards.forEach((c, i) => {\n        const base = acc + ws[i] / 2; acc += ws[i] + gap;\n        let x = ((base + off + total / 2) % total + total) % total - total / 2;\n        const n = Math.max(-1.25, Math.min(1.25, x / W));\n        const rot = -n * 52, sc = 1 + Math.abs(n) * 0.12, y = Math.abs(n) * Math.abs(n) * -10;\n        const intro = Math.min(1, Math.max(0, ((now - t0) / 1000 - 0.15 - i * 0.07) / 0.9));\n        const e = 1 - Math.pow(1 - intro, 3);\n        const fade = 1 - Math.max(0, Math.min(1, (Math.abs(x) - W * 0.92) / (W * 0.18)));\n        c.style.opacity = String(e * fade);\n        c.style.transform = `translate(-50%,-50%) translate(${x.toFixed(1)}px,${(y + (1 - e) * 60).toFixed(1)}px) perspective(900px) rotateY(${rot.toFixed(2)}deg) scale(${(sc * (0.92 + 0.08 * e)).toFixed(3)})`;\n      });\n    };\n    this.raf = requestAnimationFrame(tick);\n    if (document.hidden) { const n = performance.now(); t0 = n - 5000; tick(n); cancelAnimationFrame(this.raf); this.raf = requestAnimationFrame(tick); }\n  }\n  renderVals() {\n    const isMobile = this.state.w < 900;\n    return {\n      isMobile, isDesktop: !isMobile,\n      menuVisible: isMobile && this.state.menu,\n      heroPhoto: this.props.heroPhoto ?? true,\n      arcRef: this.arcRef,\n      arcEnter: () => { this.hoverArc = true; },\n      arcLeave: () => { this.hoverArc = false; },\n      toggleMenu: () => this.setState(s => ({ menu: !s.menu })),\n      closeMenu: () => this.setState({ menu: false }),\n      sent: this.state.sent, notSent: !this.state.sent, sentName: this.state.sentName, thanksLine: 'Thanks' + (this.state.sentName ? ', ' + this.state.sentName : '') + '.',\n      submit: (e) => { e.preventDefault(); const n = new FormData(e.target).get('name') || ''; this.setState({ sent: true, sentName: String(n).split(' ')[0] }); },\n      resetForm: () => this.setState({ sent: false }),\n      subscribe: (e) => { e.preventDefault(); this.setState({ subscribed: true }); },\n      subLabel: this.state.subscribed ? 'Subscribed ✓' : 'Subscribe'\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"