2001, U+2004-2008, U+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"db341938-abff-442a-9feb-cd3d2f6555f8\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"70e11a62-ce96-4d5b-b5b6-e8c8e91a129c\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"5b5a9c84-6233-4187-8b24-d3e3eb336eed\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<script src=\"509f90ee-1dfc-4915-9feb-0d5130d449d2\"><\u002Fscript>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\nbutton{font:inherit}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <section data-screen-label=\"Location / Hero\" style=\"max-width:1320px;margin:0 auto;padding:clamp(40px,6vw,80px) clamp(12px,2.4vw,32px) clamp(40px,5vw,64px)\">\n    <div role=\"tablist\" aria-label=\"Location\" style=\"max-width:100%;display:inline-flex;flex-wrap:wrap;justify-content:center;gap:4px;padding:5px;border-radius:25px;background:#ECEBE6\">\n      <button role=\"tab\" sc-camel-on-click=\"{{ goChennai }}\" style=\"flex:1 1 auto;height:40px;padding:0 16px;border:none;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ bgChennai }};color:{{ fgChennai }}\">Chennai<\u002Fbutton>\n      <button role=\"tab\" sc-camel-on-click=\"{{ goIndia }}\" style=\"flex:1 1 auto;height:40px;padding:0 16px;border:none;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ bgIndia }};color:{{ fgIndia }}\">India<\u002Fbutton>\n    <\u002Fdiv>\n    <div style=\"margin-top:clamp(28px,4vw,44px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(28px,4vw,56px);align-items:center\">\n      <div>\n        <sc-if value=\"{{ isChennai }}\" hint-placeholder-val=\"{{ true }}\">\n          <h1 style=\"margin:0;font-weight:500;font-size:clamp(40px,5.6vw,80px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Web design in Chennai <span style=\"color:#9A9890\">from a studio down the road<\u002Fspan><\u002Fh1>\n          <p style=\"margin:22px 0 0;max-width:30em;font-size:18px;color:#444\">We work with clinics, schools, restaurants and retailers across Chennai, and we're happy to meet in person.<\u002Fp>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ isIndia }}\" hint-placeholder-val=\"{{ false }}\">\n          <h1 style=\"margin:0;font-weight:500;font-size:clamp(40px,5.6vw,80px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Web design across India <span style=\"color:#9A9890\">with GST-ready billing<\u002Fspan><\u002Fh1>\n          <p style=\"margin:22px 0 0;max-width:30em;font-size:18px;color:#444\">Remote projects for businesses in Bengaluru, Mumbai, Delhi, Coimbatore and beyond, run on IST.<\u002Fp>\n          <a href=\"/web-development-agency-india\" style=\"display:inline-block;margin-top:14px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid #111\">Web development agency in India ↗<\u002Fa>\n        <\u002Fsc-if>\n        <a href=\"/contact\" style=\"margin-top:28px;display:inline-flex;align-items:center;gap:14px;height:48px;padding:0 5px 0 22px;border-radius:999px;background:#FFE100;color:#111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:500\" style-hover=\"background:#111;color:#FFFFFF\">Get a Quote <span style=\"width:38px;height:38px;border-radius:50%;background:#111;color:#FFFFFF;display:flex;align-items:center;justify-content:center\">↗<\u002Fspan><\u002Fa>\n      <\u002Fdiv>\n      <div style=\"aspect-ratio:4/3;border-radius:22px;overflow:hidden;background:linear-gradient(180deg,#B5DEF7,#EAF6FE)\">\n        <sc-if value=\"{{ isChennai }}\" hint-placeholder-val=\"{{ true }}\"><image-slot id=\"loc-chennai\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Stylised Chennai skyline or map\"><\u002Fimage-slot><\u002Fsc-if>\n        <sc-if value=\"{{ isIndia }}\" hint-placeholder-val=\"{{ false }}\"><image-slot id=\"loc-india\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Stylised India map\"><\u002Fimage-slot><\u002Fsc-if>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Location / How it works\" style=\"border-radius:22px;background:#111;color:#FFFFFF;padding:clamp(48px,6vw,88px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto\">\n      <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#BDBDBD;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#FFE100\"><\u002Fspan>How working together runs<\u002Fdiv>\n      <div style=\"margin-top:28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:12px\">\n        <sc-if value=\"{{ isChennai }}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">Meet in person<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Kickoff and design reviews at your office or ours.<\u002Fp><\u002Fdiv>\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">INR pricing<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Fixed quotes in rupees with GST invoices.<\u002Fp><\u002Fdiv>\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">Tamil and English<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Bilingual sites so every customer reads you clearly.<\u002Fp><\u002Fdiv>\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">Local SEO<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Pages and Maps listings for your neighbourhood.<\u002Fp><\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ isIndia }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">GST-friendly invoicing<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Proper tax invoices for every milestone.<\u002Fp><\u002Fdiv>\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">UPI and bank transfer<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Pay the way your accounts team prefers.<\u002Fp><\u002Fdiv>\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">Video calls in IST<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Weekly reviews on Google Meet.<\u002Fp><\u002Fdiv>\n          <div style=\"border-radius:18px;background:#1C1C1C;padding:22px\"><h3 style=\"margin:0 0 8px;font-weight:500;font-size:20px;letter-spacing:-0.03em\">Hindi and regional pages<\u002Fh3><p style=\"margin:0;font-size:15px;color:#BDBDBD\">Language versions as an add-on.<\u002Fp><\u002Fdiv>\n        <\u002Fsc-if>\n                      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Location / Services\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px) 0\">\n    <h2 style=\"margin:0 0 24px;font-weight:500;font-size:clamp(28px,3.4vw,46px);letter-spacing:-0.05em\">Services <span style=\"color:#9A9890\">available here<\u002Fspan><\u002Fh2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr));gap:12px\">\n      <a href=\"/industries#ecommerce\" style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px;border-radius:18px;background:#ECEBE6\" style-hover=\"background:#FFFFFF;color:#111\"><span style=\"font-size:18px;font-weight:500;letter-spacing:-0.03em\">E-commerce<\u002Fspan><span>↗<\u002Fspan><\u002Fa>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { loc: (typeof location !== 'undefined' && ['chennai', 'india'].includes(location.hash.slice(1))) ? location.hash.slice(1) : 'chennai' };\n  componentDidMount() { this.h = () => { const k = location.hash.slice(1); if (['chennai', 'india'].includes(k)) this.setState({ loc: k }); }; window.addEventListener('hashchange', this.h); }\n  componentWillUnmount() { window.removeEventListener('hashchange', this.h); }\n  go(loc) { this.setState({ loc }); try { history.replaceState(null, '', '#' + loc); } catch (e) {} }\n  renderVals() {\n    const s = this.state.loc;\n    const bg = (k) => (s === k ? '#111' : 'transparent'), fg = (k) => (s === k ? '#FFFFFF' : '#111');\n    return {\n      isChennai: s === 'chennai', isIndia: s === 'india',\n      goChennai: () => this.go('chennai'), goIndia: () => this.go('india'),\n      bgChennai: bg('chennai'), fgChennai: fg('chennai'), bgIndia: bg('india'), fgIndia: fg('india')\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"