nt-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"62d892e4-7cb1-40de-a68e-d44a7950d5e0\") format('woff2');\n  unicode-range: U+2000-2001, U+2004-2008, U+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"16e15ec3-d6c1-4ec0-af85-6a2ae632ac15\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"c844a5db-79e3-4f6b-a895-f684611c62bc\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"ad39838c-c583-4e74-9e12-013264901f34\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\nbutton{font:inherit}\nsummary{list-style:none;cursor:pointer}\nsummary::-webkit-details-marker{display:none}\n::selection{background:#FFE100;color:#111}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" active=\"pricing\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <section data-screen-label=\"Pricing / Hero\" style=\"text-align:center;padding:clamp(48px,7vw,96px) 20px clamp(32px,4vw,48px)\">\n    <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;justify-content:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>Pricing<\u002Fdiv>\n    <h1 style=\"margin:20px auto 0;max-width:13em;font-weight:500;font-size:clamp(40px,5.8vw,82px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Fixed prices, <span style=\"color:#9A9890\">agreed before we start<\u002Fspan><\u002Fh1>\n    <p style=\"margin:20px auto 0;max-width:34em;font-size:17px;color:#555;text-wrap:pretty\">Starting prices for each type of project. You get a written quote with exact scope after a 20-minute call.<\u002Fp>\n    <div style=\"margin:32px auto 0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px\">\n      <div role=\"tablist\" aria-label=\"Project type\" style=\"max-width:100%;display:inline-flex;flex-wrap:wrap;justify-content:center;padding:5px;border-radius:26px;background:#ECEBE6\">\n        <sc-for list=\"{{ cats }}\" as=\"c\" hint-placeholder-count=\"3\">\n          <button role=\"tab\" sc-camel-on-click=\"{{ c.pick }}\" style=\"flex:1 1 auto;white-space:nowrap;height:42px;padding:0 18px;border:none;border-radius:999px;cursor:pointer;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ c.bg }};color:{{ c.fg }}\">{{ c.label }}<\u002Fbutton>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Pricing / Tiers\" style=\"max-width:1320px;margin:0 auto;padding:0 clamp(12px,2.4vw,32px) clamp(56px,7vw,88px)\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:12px;max-width:{{ gridMax }};margin:0 auto\">\n      <sc-for list=\"{{ tiers }}\" as=\"t\" hint-placeholder-count=\"3\">\n        <div style=\"position:relative;border-radius:22px;padding:24px;display:flex;flex-direction:column;gap:18px;background:{{ t.bg }};color:{{ t.fg }}\">\n          <sc-if value=\"{{ t.popular }}\" hint-placeholder-val=\"{{ false }}\">\n            <span style=\"position:absolute;right:16px;top:16px;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:999px;background:#FFE100;color:#111\">Most chosen<\u002Fspan>\n          <\u002Fsc-if>\n          <div><h2 style=\"margin:0;font-weight:500;font-size:22px;letter-spacing:-0.03em\">{{ t.name }}<\u002Fh2><p style=\"margin:4px 0 0;font-size:14px;color:{{ t.sub }}\">{{ t.forWho }}<\u002Fp><\u002Fdiv>\n          <div><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:{{ t.sub }}\">Starting at<\u002Fdiv><div style=\"margin-top:4px;font-size:46px;letter-spacing:-0.06em;line-height:1\">{{ t.price }}<\u002Fdiv><div style=\"font-size:13px;margin-top:6px;color:{{ t.sub }}\">{{ t.note }}<\u002Fdiv><\u002Fdiv>\n          <a href=\"/contact\" style=\"display:flex;align-items:center;justify-content:center;height:46px;border-radius:999px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:{{ t.btnBg }};color:{{ t.btnFg }};border:{{ t.btnBorderCss }}\">Get a quote<\u002Fa>\n          <div style=\"display:flex;flex-direction:column;gap:10px;font-size:15px;padding-top:18px;border-top:{{ t.lineCss }}\">\n            <sc-for list=\"{{ t.features }}\" as=\"f\" hint-placeholder-count=\"5\">\n              <span style=\"display:flex;gap:10px\"><span style=\"color:{{ t.tick }}\">✓<\u002Fspan>{{ f }}<\u002Fspan>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n          <div style=\"margin-top:auto;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding-top:16px;border-top:{{ t.lineCss }};font-size:13px\">\n            <div><div style=\"font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:{{ t.sub }}\">{{ t.timeLabel }}<\u002Fdiv><div style=\"margin-top:2px\">{{ t.time }}<\u002Fdiv><\u002Fdiv>\n            <div><div style=\"font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:{{ t.sub }}\">{{ t.supportLabel }}<\u002Fdiv><div style=\"margin-top:2px\">{{ t.support }}<\u002Fdiv><\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n    <p style=\"margin:16px 0 0;font-size:14px;color:#666;text-align:center\">{{ taxNote }}<\u002Fp>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Pricing / Included\" style=\"border-radius:22px;background:#111;color:#FFFFFF;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(28px,5vw,64px)\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#BDBDBD;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#FFE100\"><\u002Fspan>No hidden extras<\u002Fdiv>\n        <h2 style=\"margin:18px 0 0;font-weight:500;font-size:clamp(28px,3.4vw,46px);line-height:1.1;letter-spacing:-0.05em\">Included in every package <span style=\"color:#8A8A8A\">and what isn't<\u002Fspan><\u002Fh2>\n        <p style=\"margin:18px 0 0;color:#BDBDBD;max-width:28em\">Low quotes often leave out SEO setup, tracking or copy. Ours list exactly what you get, and what you pay for separately.<\u002Fp>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:12px\">\n        <div style=\"border-radius:18px;background:#1C1C1C;padding:20px\">\n          <div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#FFE100;margin-bottom:12px\">Always included<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:8px;font-size:15px\"><span>Mobile-first responsive build<\u002Fspan><span>On-page SEO and sitemap<\u002Fspan><span>SSL and basic security<\u002Fspan><span>GA4 and Search Console<\u002Fspan><span>Speed optimisation<\u002Fspan><span>WhatsApp and contact form<\u002Fspan><span>Handover video and logins<\u002Fspan><\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"border-radius:18px;background:#1C1C1C;padding:20px\">\n          <div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#8A8A8A;margin-bottom:12px\">Billed to you directly<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:8px;font-size:15px;color:#BDBDBD\"><span>Domain name<\u002Fspan><span>Hosting<\u002Fspan><span>Paid themes or plugins<\u002Fspan><span>Shopify subscription<\u002Fspan><span>Stock photos<\u002Fspan><span>Ad spend<\u002Fspan><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <sc-if value=\"{{ showCompare }}\" hint-placeholder-val=\"{{ true }}\">\n  <section data-screen-label=\"Pricing / Compare\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px) 0\">\n    <h2 style=\"margin:0 0 24px;font-weight:500;font-size:clamp(28px,3.4vw,46px);letter-spacing:-0.05em\">{{ compareTitle }}<\u002Fh2>\n    <div style=\"overflow-x:auto;border-radius:20px;background:#FFFFFF;border:1px solid #E4E3DD\">\n      <div style=\"min-width:680px;font-size:15px\">\n        <div style=\"display:grid;grid-template-columns:1.6fr repeat(3,minmax(0,1fr));font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">\n          <span style=\"padding:16px 20px\">Feature<\u002Fspan>\n          <sc-for list=\"{{ tiers }}\" as=\"t\" hint-placeholder-count=\"3\"><span style=\"padding:16px 12px;background:{{ t.colBg }};color:#111\">{{ t.name }}<\u002Fspan><\u002Fsc-for>\n        <\u002Fdiv>\n        <sc-for list=\"{{ rows }}\" as=\"r\" hint-placeholder-count=\"8\">\n          <div style=\"display:grid;grid-template-columns:1.6fr repeat(3,minmax(0,1fr));border-top:1px solid #EEE\">\n            <span style=\"padding:13px 20px\">{{ r.label }}<\u002Fspan>\n            <span style=\"padding:13px 12px;color:{{ r.c0 }}\">{{ r.v0 }}<\u002Fspan>\n            <span style=\"padding:13px 12px;background:#FFFBD6;color:{{ r.c1 }}\">{{ r.v1 }}<\u002Fspan>\n            <span style=\"padding:13px 12px;color:{{ r.c2 }}\">{{ r.v2 }}<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n  <\u002Fsc-if>\n\n  <section data-screen-label=\"Pricing / Care + Add-ons\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px)\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:16px\">\n      <div>\n        <h2 style=\"margin:0 0 20px;font-weight:500;font-size:clamp(26px,3vw,40px);letter-spacing:-0.05em\">Monthly care plans<\u002Fh2>\n        <div style=\"display:flex;flex-direction:column;gap:10px\">\n          <div style=\"border-radius:18px;background:#ECEBE6;padding:22px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px\">\n            <div style=\"max-width:22em\"><div style=\"font-size:19px;font-weight:500;letter-spacing:-0.03em\">Care<\u002Fdiv><div style=\"margin-top:4px;font-size:14px;color:#555\">Updates, backups, uptime monitoring, monthly speed check, 1 hour of edits.<\u002Fdiv><\u002Fdiv>\n            <div style=\"font-size:30px;letter-spacing:-0.05em\">{{ care1 }}<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"border-radius:18px;background:#FFE100;padding:22px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px\">\n            <div style=\"max-width:22em\"><div style=\"font-size:19px;font-weight:500;letter-spacing:-0.03em\">Care + SEO<\u002Fdiv><div style=\"margin-top:4px;font-size:14px;color:#3A3500\">Everything in Care, plus 3 hours of edits, technical SEO fixes and a monthly ranking report.<\u002Fdiv><\u002Fdiv>\n            <div style=\"font-size:30px;letter-spacing:-0.05em\">{{ care2 }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div>\n        <h2 style=\"margin:0 0 20px;font-weight:500;font-size:clamp(26px,3vw,40px);letter-spacing:-0.05em\">Add-ons<\u002Fh2>\n        <div style=\"border-radius:18px;background:#FFFFFF;border:1px solid #E4E3DD;overflow:hidden\">\n          <sc-for list=\"{{ addons }}\" as=\"a\" hint-placeholder-count=\"7\">\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:14px 20px;border-top:1px solid #EEE\"><span style=\"font-size:16px\">{{ a.label }}<\u002Fspan><span style=\"font-size:17px;letter-spacing:-0.03em;white-space:nowrap\">{{ a.price }}<\u002Fspan><\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Pricing / Payment\" style=\"max-width:1320px;margin:0 auto;padding:0 clamp(12px,2.4vw,32px) clamp(64px,8vw,112px)\">\n    <h2 style=\"margin:0 0 20px;font-weight:500;font-size:clamp(26px,3vw,40px);letter-spacing:-0.05em\">How payment works<\u002Fh2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:12px\">\n      <div style=\"border-radius:18px;background:#2EB0EC;color:#FFFFFF;padding:22px\"><div style=\"font-size:44px;letter-spacing:-0.06em;line-height:1\">50%<\u002Fdiv><div style=\"margin-top:10px;font-size:15px\">To book your slot and start discovery<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#E5007D;color:#FFFFFF;padding:22px\"><div style=\"font-size:44px;letter-spacing:-0.06em;line-height:1\">30%<\u002Fdiv><div style=\"margin-top:10px;font-size:15px\">When you approve the design<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#111;color:#FFFFFF;padding:22px\"><div style=\"font-size:44px;letter-spacing:-0.06em;line-height:1\">20%<\u002Fdiv><div style=\"margin-top:10px;font-size:15px\">At launch, before handover<\u002Fdiv><\u002Fdiv>\n      <div style=\"border-radius:18px;background:#ECEBE6;padding:22px\"><div style=\"font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#666\">Methods<\u002Fdiv><div style=\"margin-top:10px;font-size:15px\">{{ payMethods }}<\u002Fdiv><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Pricing / FAQ\" style=\"max-width:1320px;margin:0 auto;padding:0 clamp(12px,2.4vw,32px) clamp(64px,8vw,112px)\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(28px,5vw,72px)\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>Pricing FAQ<\u002Fdiv>\n        <h2 style=\"margin:18px 0 0;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">Quotes, invoices <span style=\"color:#9A9890\">and changes<\u002Fspan><\u002Fh2>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:8px\">\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Why \"starting at\" and not a fixed price?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">The starting price covers the package as listed. After a short call, you get a fixed written quote for your exact scope, and that price doesn't change unless the scope does.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Do you provide GST invoices?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Yes. Every milestone gets a GST invoice, with your GSTIN added if you have one.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">What if I need changes after approval?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Extra work is billed at the hourly rate in the add-ons list. We send an estimate and wait for your OK before starting.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Is the care plan required?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">No. It's optional and month-to-month. You can cancel any time and keep full control of your site.<\u002Fp><\u002Fdetails>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"Pricing / CTA\" style=\"border-radius:22px;background:radial-gradient(50% 40% at 10% 100%,rgba(255,255,255,.7),transparent 70%),linear-gradient(160deg,#0A6CC2,#2EA0E8 60%,#8FD0F4);color:#FFFFFF;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:28px\">\n      <h2 style=\"margin:0;max-width:12em;font-weight:500;font-size:clamp(34px,4.6vw,64px);line-height:1.04;letter-spacing:-0.055em\">Not sure which fits? <span style=\"color:#D4ECFB\">Get a fixed quote in 24 hours.<\u002Fspan><\u002Fh2>\n      <a href=\"/contact\" style=\"display:inline-flex;align-items:center;gap:14px;height:50px;padding:0 5px 0 22px;border-radius:999px;background:#FFE100;color:#111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:500\" style-hover=\"background:#FFFFFF;color:#111\">Get a Quote <span style=\"width:40px;height:40px;border-radius:50%;background:#111;color:#FFFFFF;display:flex;align-items:center;justify-content:center\">↗<\u002Fspan><\u002Fa>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  state = { cur: null, cat: 'web' };\n  renderVals() {\n    const cur = 'INR';\n    const inr = cur === 'INR';\n    const $ = (i, u) => (inr ? i : u);\n    const D = {\n      web: {\n        label: 'Websites',\n        tiers: [\n          { name: 'Website', forWho: 'Local businesses getting online', price: $('₹40,000', '$600'), features: ['Up to 50 pages', 'Basic SEO', 'Google Business Profile included', 'Extra pages ₹5,000 each'], time: '2–3 weeks', support: '2 weeks' }\n        ],\n        rows: []\n      },\n      shop: {\n        label: 'E-commerce',\n        tiers: [\n          { name: 'Online store', forWho: 'Brands selling products online', price: $('₹50,000', '$750'), features: ['Up to 50 products', 'Shopify or WooCommerce', 'UPI, cards, COD', 'Shipping and GST setup', 'Product schema'], time: '4–5 weeks', support: '1 month' }\n        ],\n        rows: []\n      },\n      custom: {\n        label: 'Custom builds',\n        tiers: [\n          { name: 'Landing page', forWho: 'Ads, launches and lead capture', price: $('₹20,000', '$300'), features: ['1 long-form page', 'Custom design', 'Form + CRM hookup', 'Pixel and conversion tracking'], time: '1–2 weeks', support: '2 weeks' }\n        ],\n        rows: []\n      },\n      growth: {\n        label: 'SEO & Ads',\n        tiers: [\n          { name: 'SEO', forWho: 'Businesses that want to rank on Google', price: $('₹35,000', '$420'), monthly: true, features: ['Keyword research and strategy', 'On-page and technical SEO fixes', 'Google Business Profile management', 'SEO content and blog optimisation', 'Quality backlink building', 'Monthly ranking and traffic report'], time: '1 week', support: 'Monthly' },\n          { name: 'Ads', forWho: 'Businesses that want leads from paid ads', price: $('₹30,000', '$360'), monthly: true, features: ['Google Ads and Meta (Facebook, Instagram) ads', 'Campaign setup, audiences and targeting', 'Ad copy and creatives', 'Conversion tracking setup', 'Weekly optimisation and A/B testing', 'Monthly performance report', 'Ad spend paid directly by you'], time: '1 week', support: 'Monthly' }\n        ],\n        rows: []\n      }\n    };\n    const cat = D[this.state.cat];\n    const styles = (t) => t.popular\n      ? { bg: '#111', fg: '#FFFFFF', sub: '#BDBDBD', line: '#333', tick: '#FFE100', btnBg: '#FFE100', btnFg: '#111', btnBorder: '#FFE100', btnBorderCss: '1px solid #FFE100', lineCss: '1px solid #333', colBg: '#FFFBD6' }\n      : { bg: '#ECEBE6', fg: '#111', sub: '#666', line: '#DDDCD6', tick: '#0A8BDA', btnBg: 'transparent', btnFg: '#111', btnBorder: '#111', btnBorderCss: '1px solid #111', lineCss: '1px solid #DDDCD6', colBg: 'transparent' };\n    const tiers = cat.tiers.map(t => ({ ...t, popular: !!t.popular, note: t.monthly ? (inr ? 'per month · + GST' : 'per month · USD') : (inr ? 'one-time · + GST' : 'one-time · USD'), timeLabel: t.monthly ? 'Starts in' : 'Delivery', supportLabel: t.monthly ? 'Reporting' : 'Support', ...styles(t) }));\n    const dim = (v) => (v === '—' ? '#AAA' : '#111');\n    return {\n      cats: Object.entries(D).map(([k, v]) => ({ label: v.label, pick: () => this.setState({ cat: k }), bg: this.state.cat === k ? '#111' : 'transparent', fg: this.state.cat === k ? '#FFFFFF' : '#111' })),\n      curs: [['INR', '₹ INR'], ['USD', '$ USD']].map(([k, l]) => ({ label: l, pick: () => this.setState({ cur: k }), bg: cur === k ? '#111' : 'transparent', fg: cur === k ? '#FFFFFF' : '#111' })),\n      tiers, gridMax: tiers.length === 1 ? '420px' : tiers.length === 2 ? '860px' : 'none', showCompare: cat.rows.length > 0, compareTitle: 'Compare ' + cat.label.toLowerCase() + ' packages',\n      rows: cat.rows.map(([label, a, b, c]) => ({ label, v0: a, v1: b, v2: c, c0: dim(a), c1: dim(b), c2: dim(c) })),\n      taxNote: inr ? 'Prices exclude 18% GST. Final quote confirmed in writing after a short call.' : 'Prices in USD, no Indian tax for overseas clients. Final quote confirmed in writing after a short call.',\n      care1: $('₹4,000/mo', '$75/mo'), care2: $('₹9,000/mo', '$160/mo'),\n      addons: [\n        ['Extra page', $('₹5,000', '$60')], ['Copywriting, per page', $('₹2,500', '$45')], ['Tamil or Hindi version', $('₹15,000', '$250')],\n        ['Logo and brand kit', $('₹20,000', '$350')], ['Product upload, per 50', $('₹5,000', '$90')], ['Store migration', $('₹30,000', '$500')],\n        ['Extra work, per hour', $('₹1,800', '$30')]\n      ].map(([label, price]) => ({ label, price })),\n      payMethods: inr ? 'UPI, bank transfer (NEFT/IMPS) or card. GST invoice for every milestone.' : 'Card, PayPal, Wise or wire transfer. Invoiced in USD.'\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"