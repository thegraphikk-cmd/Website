"<!DOCTYPE html>\n<html><head>\n\n\n\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"canonical\" href=\"https://thegraphikk.com/pricing\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Website Design &amp; Development Pricing in India (INR) — The Graphikk\">\n<meta property=\"og:description\" content=\"Fixed-price website, e-commerce and custom web development packages from a Chennai agency. Websites from ₹40,000, online stores from ₹50,000, SEO and ads from ₹30,000/month. Prices in INR, plus GST.\">\n<meta property=\"og:url\" content=\"https://thegraphikk.com/pricing\">\n<meta property=\"og:site_name\" content=\"The Graphikk\">\n<meta property=\"og:image\" content=\"https://thegraphikk.com/assets/img/og-blog.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script src=\"2d866e4b-9a4e-4d46-bfcf-f3d628e77e39\"><\u002Fscript>\n<script defer src=\"/_vercel/insights/script.js\"><\u002Fscript><script defer src=\"/_vercel/speed-insights/script.js\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<title>Website Design &amp; Development Pricing in India (INR) — The Graphikk<\u002Ftitle>\n<meta name=\"description\" content=\"Fixed-price website, e-commerce and custom web development packages from a Chennai agency. Websites from ₹40,000, online stores from ₹50,000, SEO and ads from ₹30,000/month. Prices in INR, plus GST.\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<style>/* cyrillic-ext */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"7d2f99be-1d5d-4f0d-8ac2-74b91d9f3cac\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Geist';\n  font-style: normal;\n  f