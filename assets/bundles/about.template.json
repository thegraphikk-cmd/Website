,2.4vw,32px) clamp(56px,7vw,96px)\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(28px,5vw,72px);align-items:center\">\n      <div>\n        <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>About<\u002Fdiv>\n        <h1 style=\"margin:20px 0 0;font-weight:500;font-size:clamp(40px,5.6vw,80px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">A small studio <span style=\"color:#9A9890\">that designs, films and builds<\u002Fspan><\u002Fh1>\n        <div style=\"margin-top:28px;display:flex;flex-direction:column;gap:16px;font-size:18px;line-height:1.6;color:#333;max-width:32em;text-wrap:pretty\">\n          <p style=\"margin:0\">The Graphikk started as a one-person design practice in Chennai, making brand material for local shops and clinics. Clients kept asking for websites, so the studio learned to build them properly.<\u002Fp>\n          <p style=\"margin:0\">Today the same small team handles strategy, design, video and code, for businesses and individuals across India.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"margin-top:24px;display:flex;align-items:center;gap:12px\"><div><div style=\"font-weight:600\">Kavin Arulraj<\u002Fdiv><div style=\"font-size:14px;color:#666\">Designer &amp; Editor<\u002Fdiv><\u002Fdiv><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"aspect-ratio:4/5;max-height:680px;border-radius:22px;overflow:hidden;background:linear-gradient(180deg,#1A8BDD,#8FD0F4)\"><image-slot id=\"about-portrait\" src=\"data:image/webp;base64,\" shape=\"rect\" alt=\"Kavin Arulraj, founder of The Graphikk\" placeholder=\"Professional founder portrait · 4:5\"><\u002Fimage-slot><\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"About / Philosophy\" style=\"border-radius:22px;background:#111;color:#FFFFFF;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto\">\n      <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#BDBDBD;display:flex;align-items:center;gap:8px\"><span style=\"width:5px;height:5px;background:#FFE100\"><\u002Fspan>How we think<\u002Fdiv>\n      <h2 style=\"margin:18px 0 0;max-width:15em;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">Three rules <span style=\"color:#8A8A8A\">behind every project<\u002Fspan><\u002Fh2>\n      <div style=\"margin-top:36px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:12px\">\n        <div style=\"border-radius:18px;background:#1C1C1C;padding:24px\"><span style=\"width:10px;height:10px;display:block;border-radius:50%;background:#2EB0EC\"><\u002Fspan><h3 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em\">Clarity first<\u002Fh3><p style=\"margin:0;color:#BDBDBD\">A visitor should know what you do and what to do next within five seconds.<\u002Fp><\u002Fdiv>\n        <div style=\"border-radius:18px;background:#1C1C1C;padding:24px\"><span style=\"width:10px;height:10px;display:block;border-radius:50%;background:#E5007D\"><\u002Fspan><h3 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em\">Speed is a feature<\u002Fh3><p style=\"margin:0;color:#BDBDBD\">A fast site ranks better, converts better and costs less to run.<\u002Fp><\u002Fdiv>\n        <div style=\"border-radius:18px;background:#1C1C1C;padding:24px\"><span style=\"width:10px;height:10px;display:block;border-radius:50%;background:#FFE100\"><\u002Fspan><h3 style=\"margin:28px 0 8px;font-weight:500;font-size:22px;letter-spacing:-0.03em\">One team, start to finish<\u002Fh3><p style=\"margin:0;color:#BDBDBD\">The people who design your site build it and support it after launch.<\u002Fp><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"About / Skills\" style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(12px,2.4vw,32px) 0\">\n    <h2 style=\"margin:0 0 28px;font-weight:500;font-size:clamp(30px,3.8vw,52px);line-height:1.1;letter-spacing:-0.05em\">Skills <span style=\"color:#9A9890\">under one roof<\u002Fspan><\u002Fh2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px\">\n      <div style=\"border-radius:20px;background:#2EB0EC;color:#FFFFFF;padding:24px;min-height:240px;display:flex;flex-direction:column\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">01<\u002Fdiv><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:30px;letter-spacing:-0.045em\">Design<\u002Fh3><p style=\"margin:0;color:#EAF6FE\">UI/UX, brand identity, wireframes and prototypes in Figma.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#E5007D;color:#FFFFFF;padding:24px;min-height:240px;display:flex;flex-direction:column\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">02<\u002Fdiv><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:30px;letter-spacing:-0.045em\">Video<\u002Fh3><p style=\"margin:0;color:#FFE3F1\">Product films, explainer clips and social edits for launches.<\u002Fp><\u002Fdiv>\n      <div style=\"border-radius:20px;background:#FFE100;padding:24px;min-height:240px;display:flex;flex-direction:column\"><div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">03<\u002Fdiv><h3 style=\"margin:auto 0 8px;font-weight:500;font-size:30px;letter-spacing:-0.045em\">Web<\u002Fh3><p style=\"margin:0;color:#3A3500\">Custom code, Shopify, WordPress, technical SEO and speed.<\u002Fp><\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"margin-top:12px;aspect-ratio:21/9;border-radius:22px;overflow:hidden;background:#ECEBE6\"><image-slot id=\"about-workspace\" src=\"data:image/webp;base64,\" shape=\"rect\" placeholder=\"Behind-the-scenes workspace shot · 21:9\"><\u002Fimage-slot><\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"About / CTA\" style=\"margin-top:clamp(64px,8vw,112px);border-radius:22px;background:radial-gradient(50% 40% at 10% 100%,rgba(255,255,255,.7),transparent 70%),linear-gradient(160deg,#0A6CC2,#2EA0E8 60%,#8FD0F4);color:#FFFFFF;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:28px\">\n      <h2 style=\"margin:0;max-width:12em;font-weight:500;font-size:clamp(34px,4.6vw,64px);line-height:1.04;letter-spacing:-0.055em\">Let's work together. <span style=\"color:#D4ECFB\">Start with a short brief.<\u002Fspan><\u002Fh2>\n      <a href=\"/contact\" style=\"display:inline-flex;align-items:center;gap:14px;height:50px;padding:0 5px 0 22px;border-radius:999px;background:#FFE100;color:#111;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:500\" style-hover=\"background:#FFFFFF;color:#111\">Get a Quote <span style=\"width:40px;height:40px;border-radius:50%;background:#111;color:#FFFFFF;display:flex;align-items:center;justify-content:center\">↗<\u002Fspan><\u002Fa>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n\n\n<\u002Fbody><\u002Fhtml>"