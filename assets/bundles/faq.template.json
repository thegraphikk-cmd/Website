at('woff2');\n  unicode-range: U+2000-2001, U+2004-2008, U+200A, U+23B8-23BD, U+2500-259F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"8a2006e8-07fe-4314-87fb-48101eca485d\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"d37e42a9-cac0-4130-a5d1-82e9cf6035ea\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Geist Mono';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"d0fe0407-8508-4f48-82de-8b8994971c33\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\nhtml,body{margin:0;padding:0;background:#F7F6F2;color:#111;-webkit-font-smoothing:antialiased}\n*{box-sizing:border-box}\na{color:#111;text-decoration:none}\na:hover{color:#0A6FC4}\nsummary{list-style:none;cursor:pointer}\nsummary::-webkit-details-marker{display:none}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div style=\"font-family:Geist,system-ui,sans-serif;font-size:16px;line-height:1.5;color:#111;background:#F7F6F2;min-height:100vh;padding:8px\">\n  <dc-import name=\"SiteHeader\" hint-size=\"100%,68px\" style=\"position:sticky;top:8px;z-index:50;display:block\"><\u002Fdc-import>\n\n  <section data-screen-label=\"FAQ / Hero\" style=\"text-align:center;padding:clamp(48px,7vw,96px) 20px clamp(32px,4vw,48px)\">\n    <div style=\"font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#555;display:flex;align-items:center;justify-content:center;gap:8px\"><span style=\"width:5px;height:5px;background:#111\"><\u002Fspan>FAQ<\u002Fdiv>\n    <h1 style=\"margin:20px auto 0;max-width:13em;font-weight:500;font-size:clamp(40px,5.8vw,82px);line-height:1.02;letter-spacing:-0.055em;text-wrap:balance\">Questions <span style=\"color:#9A9890\">we hear most<\u002Fspan><\u002Fh1>\n    <nav style=\"margin-top:28px;display:flex;flex-wrap:wrap;justify-content:center;gap:6px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\">\n      <a href=\"#faq-pricing\" style=\"padding:10px 16px;border-radius:999px;background:#ECEBE6\">Pricing<\u002Fa><a href=\"#faq-process\" style=\"padding:10px 16px;border-radius:999px;background:#ECEBE6\">Process<\u002Fa><a href=\"#faq-technical\" style=\"padding:10px 16px;border-radius:999px;background:#ECEBE6\">Technical<\u002Fa><a href=\"#faq-support\" style=\"padding:10px 16px;border-radius:999px;background:#ECEBE6\">Support<\u002Fa>\n    <\u002Fnav>\n  <\u002Fsection>\n\n  <section data-screen-label=\"FAQ / Groups\" style=\"max-width:1100px;margin:0 auto;padding:0 clamp(12px,2.4vw,32px) clamp(64px,8vw,112px);display:flex;flex-direction:column;gap:clamp(40px,5vw,64px)\">\n    <div id=\"faq-pricing\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:20px 40px\">\n      <h2 style=\"margin:0;font-weight:500;font-size:28px;letter-spacing:-0.045em;display:flex;align-items:center;gap:12px\"><span style=\"width:12px;height:12px;border-radius:50%;background:#2EB0EC\"><\u002Fspan>Pricing<\u002Fh2>\n      <div style=\"grid-column:span 2;display:flex;flex-direction:column;gap:8px;min-width:0\">\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">How much does a website cost?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Websites start at ₹40,000, online stores at ₹50,000 and landing pages at ₹20,000, plus GST. SEO is ₹35,000 a month and ads management ₹30,000 a month. See the <a href=\"/pricing\" style=\"border-bottom:1px solid #111\">pricing page<\u002Fa> for what each includes.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">How do payments work?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">50% to start, 30% on design approval and 20% at launch.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Are there any recurring costs?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Domain and hosting, billed to you directly. The care plan is optional.<\u002Fp><\u002Fdetails>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div id=\"faq-process\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:20px 40px\">\n      <h2 style=\"margin:0;font-weight:500;font-size:28px;letter-spacing:-0.045em;display:flex;align-items:center;gap:12px\"><span style=\"width:12px;height:12px;border-radius:50%;background:#E5007D\"><\u002Fspan>Process<\u002Fh2>\n      <div style=\"grid-column:span 2;display:flex;flex-direction:column;gap:8px;min-width:0\">\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">How long does a website take?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Three to eight weeks depending on size. See the full <a href=\"/process\" style=\"border-bottom:1px solid #111\">process<\u002Fa>.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">What do you need from me?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Your logo, any brand material, photos if you have them, and an hour a week for reviews.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Can you write the content?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Yes. Copywriting is included in Premium and available as an add-on for other packages.<\u002Fp><\u002Fdetails>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div id=\"faq-technical\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:20px 40px\">\n      <h2 style=\"margin:0;font-weight:500;font-size:28px;letter-spacing:-0.045em;display:flex;align-items:center;gap:12px\"><span style=\"width:12px;height:12px;border-radius:50%;background:#FFE100\"><\u002Fspan>Technical<\u002Fh2>\n      <div style=\"grid-column:span 2;display:flex;flex-direction:column;gap:8px;min-width:0\">\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Which platform will you use?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Custom code, WordPress, Shopify or WooCommerce, depending on your needs. We explain the choice in the proposal.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Will my site rank on Google?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Every build is SEO-ready: clean structure, schema and fast load times. Rankings also depend on content and competition.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">Do I own the website?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Yes. Once paid in full, the site, code and content are yours.<\u002Fp><\u002Fdetails>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div id=\"faq-support\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:20px 40px\">\n      <h2 style=\"margin:0;font-weight:500;font-size:28px;letter-spacing:-0.045em;display:flex;align-items:center;gap:12px\"><span style=\"width:12px;height:12px;border-radius:50%;background:#111\"><\u002Fspan>Support<\u002Fh2>\n      <div style=\"grid-column:span 2;display:flex;flex-direction:column;gap:8px;min-width:0\">\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">What happens after launch?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Each package includes a support period for fixes and small changes.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">What's in the care plan?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Updates, backups, uptime monitoring, monthly speed checks and up to two hours of edits.<\u002Fp><\u002Fdetails>\n        <details style=\"border-radius:16px;background:#ECEBE6;padding:0 20px\"><summary style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:64px;font-size:17px;font-weight:500;letter-spacing:-0.02em\">How fast do you reply?<span style=\"flex:none;width:30px;height:30px;border-radius:50%;background:#FFFFFF;display:flex;align-items:center;justify-content:center\">+<\u002Fspan><\u002Fsummary><p style=\"margin:0;padding:0 0 20px;color:#555\">Within 24 hours on working days, usually the same day.<\u002Fp><\u002Fdetails>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section data-screen-label=\"FAQ / CTA\" style=\"border-radius:22px;background:#FFE100;padding:clamp(40px,5vw,72px) clamp(20px,4vw,56px)\">\n    <div style=\"max-width:1240px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px\">\n      <h2 style=\"margin:0;max-width:14em;font-weight:500;font-size:clamp(30px,4vw,54px);line-height:1.06;letter-spacing:-0.05em\">Still have a question? <span style=\"color:#6B6200\">Ask us directly.<\u002Fspan><\u002Fh2>\n      <a href=\"/contact\" style=\"display:inline-flex;align-items:center;gap:12px;height:50px;padding:0 5px 0 22px;border-radius:999px;background:#111;color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase\" style-hover=\"color:#FFFFFF\">Contact us <span style=\"width:40px;height:40px;border-radius:50%;background:#FFE100;color:#111;display:flex;align-items:center;justify-content:center\">↗<\u002Fspan><\u002Fa>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <dc-import name=\"SiteFooter\" hint-size=\"100%,560px\"><\u002Fdc-import>\n<\u002Fdiv>\n<\u002Fx-dc>\n\n\n<\u002Fbody><\u002Fhtml>"